import Lib.BackForth.InducedMap

/-!
# A concrete non-injective induced map

This realizes the abstract `jumpMap_not_injective_of_target_subsingleton` on
actual groups, so that clause (d) of the odd characterization is known to be a
non-vacuous demand.

Take `p = 2` and `β = 1`, with

* `B = ZMod 2 × ZMod 8` and `F = ⟨(1, 2)⟩`;
* `A = ZMod 8` and `E = ⟨2⟩`.

`F` is generated by an element with a **height jump**: `h(1,2) = 0` while
`h(2 · (1,2)) = h(0,4) = 2`.  That jump is exactly what makes `S_{B,F}(1)`
nonzero.  On the target side `E ⊆ 2·(ZMod 8) = G^A_1`, so `S_{A,E}(1)` collapses
by `jumpSpace_subsingleton_of_le`.  Any map between them is therefore
non-injective.
-/

open Ordinal

namespace JumpWitness

abbrev B := ZMod 2 × ZMod 8
abbrev A := ZMod 8

/-- The jumping generator of the source marked subgroup. -/
def f : B := (1, 2)

/-- The source marked subgroup `F = ⟨(1,2)⟩`. -/
def F : AddSubgroup B := AddSubgroup.zmultiples f

/-- The target marked subgroup `E = ⟨2⟩ ≤ ZMod 8`. -/
def E : AddSubgroup A := AddSubgroup.zmultiples (2 : ZMod 8)

instance : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩

/-! ### The target jump space collapses -/

/-- `E = ⟨2⟩` lies inside `G^A_1 = 2·(ZMod 8)`. -/
lemma E_le : E ≤ ulmSubgroup 2 (1 : Ordinal) (G := A) := by
  rintro x ⟨k, rfl⟩
  rw [show ((1 : Ordinal)) = ((1 : ℕ) : Ordinal) by simp, ulmSubgroup_nat, pPow_mem_iff]
  exact ⟨k • (1 : ZMod 8), by rw [smul_comm]; simp⟩

/-- Hence `S_{A,E}(1) = 0`. -/
theorem target_subsingleton : Subsingleton (jumpSpace 2 E (1 : Ordinal)) :=
  jumpSpace_subsingleton_of_le 2 E 1 E_le

/-! ### The source jump space does not -/

/-- `(0,4)` is in the numerator: it is `2 · (1,2)` with `(1,2) ∈ F`, and it has
height at least `2` because `(0,4) = 4 · (0,1)`. -/
lemma mem_num : ((0, 4) : B) ∈ jumpNum 2 F (1 : Ordinal) := by
  constructor
  · exact ⟨f, AddSubgroup.mem_zmultiples f, by decide⟩
  · rw [show Order.succ (1 : Ordinal) = ((2 : ℕ) : Ordinal) by
        rw [show ((2 : ℕ) : Ordinal) = (2 : Ordinal) by simp]
        exact (Ordinal.succ_one).symm ▸ rfl,
      ulmSubgroup_nat]
    exact ⟨((0 : ZMod 2), (1 : ZMod 8)), by decide⟩

/-- `(0,4)` is **not** in the denominator.

Any `y ∈ F ∩ G^B_1` has first coordinate `0`, because `G^B_1 = 2·B` kills the
`ZMod 2` factor; writing `y = k • (1,2)` this forces `k` even, and then
`2 • y = (0, 4k) = 0`.  So the denominator is trivial while the numerator is not. -/
lemma not_mem_den : ((0, 4) : B) ∉ jumpDen 2 F (1 : Ordinal) := by
  rintro ⟨y, ⟨hyF, hy1⟩, hy⟩
  obtain ⟨k, rfl⟩ := hyF
  rw [show ((1 : Ordinal)) = ((1 : ℕ) : Ordinal) by simp, ulmSubgroup_nat] at hy1
  obtain ⟨z, hz⟩ := hy1
  -- First coordinate.  `G^B_1 = 2·B` kills the `ZMod 2` factor, so `k` is even.
  have hfst : ((k : ZMod 2)) = 0 := by
    have h1 := congrArg Prod.fst hz
    simp only [Prod.smul_fst, pow_one] at h1
    rw [show (f.1 : ZMod 2) = 1 from rfl, zsmul_eq_mul, mul_one] at h1
    have hkill : ∀ x : ZMod 2, (2 : ℕ) • x = 0 := by decide
    rw [← h1, hkill]
  obtain ⟨m, rfl⟩ : ∃ m : ℤ, k = 2 * m := by
    obtain ⟨m, hm⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd k 2).mp hfst
    exact ⟨m, hm⟩
  -- Second coordinate.  With `k = 2m` the image is `8m = 0`, never `4`.
  have hsnd := congrArg Prod.snd hy
  simp only [Prod.smul_snd, f] at hsnd
  rw [zsmul_eq_mul] at hsnd
  push_cast at hsnd
  have : (0 : ZMod 8) = 4 := by
    rw [← hsnd]; ring_nf
    rw [show ((8 : ZMod 8)) = 0 by decide]
    ring
  exact absurd this (by decide)

/-- Therefore `S_{B,F}(1)` is not a subsingleton. -/
theorem source_not_subsingleton :
    ¬ Subsingleton (jumpSpace 2 F (1 : Ordinal)) := by
  intro hs
  have : (QuotientAddGroup.mk (⟨((0, 4) : B), mem_num⟩ : jumpNum 2 F 1)
      : jumpSpace 2 F 1) = 0 := Subsingleton.elim _ _
  exact not_mem_den
    ((QuotientAddGroup.eq_zero_iff (⟨((0, 4) : B), mem_num⟩ : jumpNum 2 F 1)).mp this)



/-! ### The conclusion -/

/-- **Every** height-floor-respecting map from `F` to `E` induces a non-injective
map on jump spaces at `β = 1` — including the genuine isomorphism `(1,2) ↦ 2`.

So injectivity of `g_bar_beta` is a real restriction on configurations, not a
property of the construction, and clause (d) of the odd characterization is not
vacuous.  A `jumpMap` built as an `AddEquiv` would make this false. -/
theorem every_jumpMap_not_injective
    (φ : F →+ E)
    (hsucc : IsHeightFloorAt 2 φ (Order.succ (1 : Ordinal)))
    (hβ : IsHeightFloorAt 2 φ (1 : Ordinal)) :
    ¬ Function.Injective (jumpMap 2 φ hsucc hβ) :=
  jumpMap_not_injective_of_target_subsingleton 2 φ hsucc hβ
    target_subsingleton source_not_subsingleton

end JumpWitness
