import Lib.Scott.Domination
import Lib.Ulm.Pure

/-!
# Tuple-generated subgroups and tuple invariants

This module packages the finite-tuple algebra used in the Scott-complexity
development.
-/

open Ordinal

universe u

variable (p : ℕ) [hp : Fact p.Prime]
variable {G : Type u} [AddCommGroup G]
variable {H : Type u} [AddCommGroup H]

section Tuples

variable {n : ℕ}

/-- The subgroup generated by a tuple. -/
def tupleSubgroup (a : Fin n → G) : AddSubgroup G :=
  AddSubgroup.closure (Set.range a)

/-- The subgroup generated by the left block of an appended tuple lies in the
subgroup generated by the whole appended tuple. -/
theorem tupleSubgroup_le_append_left
    {m : ℕ} (a : Fin n → G) (c : Fin m → G) :
    tupleSubgroup a ≤ tupleSubgroup (Fin.append a c) := by
  apply AddSubgroup.closure_mono
  rintro x ⟨i, rfl⟩
  exact ⟨i.castAdd m, by simp⟩

/-- A tuple-generated subgroup of a primary abelian `p`-group is finite.
This is the formal reason an ACM finite-tuple challenge is a finite subgroup
even when the ambient group is infinite. -/
theorem tupleSubgroup_finite (hG : IsPrimaryPGroup p G) (a : Fin n → G) :
    Set.Finite (tupleSubgroup a : Set G) := by
  have hfg : (tupleSubgroup a).FG :=
    (AddSubgroup.fg_iff (tupleSubgroup a)).2
      ⟨Set.range a, rfl, Set.finite_range a⟩
  letI : AddGroup.FG (tupleSubgroup a) :=
    (AddGroup.fg_iff_addSubgroup_fg (tupleSubgroup a)).2 hfg
  have htors : AddMonoid.IsTorsion (tupleSubgroup a) := by
    intro x
    obtain ⟨k, hk⟩ := hG (x : G)
    rw [isOfFinAddOrder_iff_nsmul_eq_zero]
    refine ⟨p ^ k, pow_pos hp.out.pos k, ?_⟩
    exact Subtype.ext hk
  letI : Finite (tupleSubgroup a) :=
    AddCommGroup.finite_of_fg_torsion (G := tupleSubgroup a) htors
  exact Set.finite_coe_iff.mp inferInstance

/-- The part of a tuple-generated subgroup lying in the `ω·γ` tail. -/
noncomputable def tupleTailSubgroup (a : Fin n → G) (γ : Ordinal.{0}) : AddSubgroup G :=
  tupleSubgroup a ⊓ ulmSubgroup p (ω * γ) (G := G)

/-- Pointwise height agreement below `ω·γ`. -/
def HeightAgreeBelow (γ : Ordinal.{0}) (a : Fin n → G) (b : Fin n → H) : Prop :=
  ∀ i : Fin n, ulmHeight p (a i) < ω * γ ↔ ulmHeight p (b i) < ω * γ

/-- A chosen isomorphism `⟨b̄⟩ → ⟨ā⟩` carrying corresponding tuple entries
to one another. Keeping the map as data is necessary for directional height
conditions on every element of the generated subgroups. -/
structure TupleIsoMap (a : Fin n → G) (b : Fin n → H) where
  equiv : tupleSubgroup (G := H) b ≃+ tupleSubgroup a
  map_gen : ∀ i : Fin n,
    equiv ⟨b i, AddSubgroup.subset_closure (Set.mem_range_self i)⟩ =
      ⟨a i, AddSubgroup.subset_closure (Set.mem_range_self i)⟩

/-- The tuple-to-tuple map extends to an isomorphism of generated subgroups. -/
def TuplesIso (a : Fin n → G) (b : Fin n → H) : Prop :=
  Nonempty (TupleIsoMap a b)



/-! ### The base relation and the tuple isomorphism are the same statement

`BFBase` asks for an isomorphism `⟨ā⟩ → ⟨b̄⟩` carrying `aᵢ` to `bᵢ`; a
`TupleIsoMap` carries the data of one going `⟨b̄⟩ → ⟨ā⟩` carrying `bᵢ` to `aᵢ`.
They are inverse to each other, so the two conditions coincide.  This is clause
(a) of all three parts of the characterization, and it is the whole content at
level `0`. -/

/-- From a base isomorphism `⟨ā⟩ → ⟨b̄⟩`, invert to get the tuple map. -/
noncomputable def TupleIsoMap.ofBase {a : Fin n → G} {b : Fin n → H}
    (φ : tupleSubgroup a ≃+ tupleSubgroup b)
    (hφ : ∀ i : Fin n,
      φ ⟨a i, AddSubgroup.subset_closure (Set.mem_range_self i)⟩ =
        ⟨b i, AddSubgroup.subset_closure (Set.mem_range_self i)⟩) :
    TupleIsoMap a b where
  equiv := φ.symm
  map_gen := by
    intro i
    rw [← hφ i]
    simp

/-- From a tuple map, invert to get a base isomorphism. -/
noncomputable def TupleIsoMap.toBase {a : Fin n → G} {b : Fin n → H}
    (g : TupleIsoMap a b) :
    { φ : tupleSubgroup a ≃+ tupleSubgroup b //
      ∀ i : Fin n,
        φ ⟨a i, AddSubgroup.subset_closure (Set.mem_range_self i)⟩ =
          ⟨b i, AddSubgroup.subset_closure (Set.mem_range_self i)⟩ } :=
  ⟨g.equiv.symm, by
    intro i
    rw [← g.map_gen i]
    simp⟩

/-- Reverse a tuple isomorphism while preserving the coordinate assignment. -/
noncomputable def TupleIsoMap.symm {a : Fin n → G} {b : Fin n → H}
    (g : TupleIsoMap a b) : TupleIsoMap b a :=
  TupleIsoMap.ofBase g.equiv g.map_gen

@[simp] theorem TupleIsoMap.symm_equiv {a : Fin n → G} {b : Fin n → H}
    (g : TupleIsoMap a b) : g.symm.equiv = g.equiv.symm :=
  rfl

@[simp] theorem TupleIsoMap.symm_symm {a : Fin n → G} {b : Fin n → H}
    (g : TupleIsoMap a b) : g.symm.symm = g := by
  cases g
  rfl

/-- The homomorphism induced by a fixed pair of tuples is unique.

Although `TupleIsoMap` stores a chosen equivalence, any two choices agree on
the closure of the displayed source generators because both send `b i` to
`a i`.  Necessity arguments use this to compare the current marked map with
the restriction of an enlarged challenge response. -/
theorem TupleIsoMap.equiv_apply_eq
    {a : Fin n → G} {b : Fin n → H}
    (g g' : TupleIsoMap a b) (x : tupleSubgroup b) :
    (g.equiv x : G) = (g'.equiv x : G) := by
  let P : ∀ y : H, y ∈ tupleSubgroup b → Prop := fun y hy ↦
    (g.equiv ⟨y, hy⟩ : G) = (g'.equiv ⟨y, hy⟩ : G)
  change P (x : H) x.property
  refine AddSubgroup.closure_induction (p := P) ?_ ?_ ?_ ?_ x.property
  · intro y hy
    obtain ⟨i, rfl⟩ := hy
    have hg := congrArg Subtype.val (g.map_gen i)
    have hg' := congrArg Subtype.val (g'.map_gen i)
    exact hg.trans hg'.symm
  · change (g.equiv 0 : G) = (g'.equiv 0 : G)
    simp
  · intro y z hy hz hyP hzP
    change (g.equiv (⟨y, hy⟩ + ⟨z, hz⟩) : G) =
      (g'.equiv (⟨y, hy⟩ + ⟨z, hz⟩) : G)
    rw [map_add, map_add]
    exact congrArg₂ (· + ·) hyP hzP
  · intro y hy hyP
    change (g.equiv (-⟨y, hy⟩) : G) = (g'.equiv (-⟨y, hy⟩) : G)
    rw [map_neg, map_neg]
    exact congrArg Neg.neg hyP

/-! ### Building a tuple isomorphism from a generated-subgroup embedding -/

/-- An injective homomorphism out of the subgroup generated by `b` which sends
every displayed generator to the corresponding entry of `a` corestricts to a
`TupleIsoMap a b`.

This is the algebraic bridge used when a finite-challenge construction returns
an embedding into the ambient target rather than an equivalence whose codomain
has already been identified with the generated image. -/
noncomputable def TupleIsoMap.ofInjectiveOnGenerators
    {a : Fin n → G} {b : Fin n → H}
    (f : tupleSubgroup b →+ G) (hf : Function.Injective f)
    (hgen : ∀ i : Fin n,
      f ⟨b i, AddSubgroup.subset_closure (Set.mem_range_self i)⟩ = a i) :
    TupleIsoMap a b := by
  let f' : tupleSubgroup b →+ tupleSubgroup a :=
    f.codRestrict (tupleSubgroup a) (by
      intro x
      change f x ∈ AddSubgroup.closure (Set.range a)
      refine AddSubgroup.closure_induction
        (p := fun y hy ↦ f ⟨y, hy⟩ ∈ AddSubgroup.closure (Set.range a))
        ?_ ?_ ?_ ?_ x.property
      · intro y hy
        obtain ⟨i, rfl⟩ := hy
        simpa [hgen i] using
          AddSubgroup.subset_closure (Set.mem_range_self i : a i ∈ Set.range a)
      · change f 0 ∈ tupleSubgroup a
        rw [map_zero]
        exact AddSubgroup.zero_mem (tupleSubgroup a)
      · intro x y hx hy hx' hy'
        change f (⟨x, hx⟩ + ⟨y, hy⟩) ∈ tupleSubgroup a
        rw [map_add]
        exact (tupleSubgroup a).add_mem hx' hy'
      · intro x hx hx'
        change f (-⟨x, hx⟩) ∈ tupleSubgroup a
        rw [map_neg]
        exact (tupleSubgroup a).neg_mem hx')
  have hf'inj : Function.Injective f' := by
    intro x y hxy
    apply hf
    exact congrArg Subtype.val hxy
  have hf'surj : Function.Surjective f' := by
    intro y
    obtain ⟨y, hy⟩ := y
    have : ∃ x : tupleSubgroup b, f x = y := by
      refine AddSubgroup.closure_induction
        (p := fun z _hz ↦ ∃ x : tupleSubgroup b, f x = z)
        ?_ ?_ ?_ ?_ hy
      · intro z hz
        obtain ⟨i, rfl⟩ := hz
        exact ⟨⟨b i, AddSubgroup.subset_closure (Set.mem_range_self i)⟩, hgen i⟩
      · exact ⟨0, by simp⟩
      · intro x y _hx _hy hx' hy'
        obtain ⟨x', rfl⟩ := hx'
        obtain ⟨y', rfl⟩ := hy'
        exact ⟨x' + y', by simp⟩
      · intro x _hx hx'
        obtain ⟨x', rfl⟩ := hx'
        exact ⟨-x', by simp⟩
    obtain ⟨x, hx⟩ := this
    exact ⟨x, Subtype.ext hx⟩
  let e : tupleSubgroup b ≃+ tupleSubgroup a :=
    AddEquiv.ofBijective f' ⟨hf'inj, hf'surj⟩
  exact
    { equiv := e
      map_gen := by
        intro i
        apply Subtype.ext
        exact hgen i }

@[simp] theorem TupleIsoMap.ofInjectiveOnGenerators_apply
    {a : Fin n → G} {b : Fin n → H}
    (f : tupleSubgroup b →+ G) (hf : Function.Injective f)
    (hgen : ∀ i : Fin n,
      f ⟨b i, AddSubgroup.subset_closure (Set.mem_range_self i)⟩ = a i)
    (x : tupleSubgroup b) :
    ((TupleIsoMap.ofInjectiveOnGenerators f hf hgen).equiv x : G) = f x := by
  rfl

/-- Restrict a tuple isomorphism to any selected list of coordinates.

The selector need not be injective: repeated coordinates merely generate a
smaller subgroup.  This is the structural weakening used when a
back-and-forth response is restricted back to the tuple present before the
challenge. -/
noncomputable def TupleIsoMap.reindex
    {m : ℕ} {a : Fin n → G} {b : Fin n → H}
    (g : TupleIsoMap a b) (e : Fin m → Fin n) :
    TupleIsoMap (a ∘ e) (b ∘ e) := by
  have hsource : tupleSubgroup (b ∘ e) ≤ tupleSubgroup b := by
    apply AddSubgroup.closure_mono
    rintro x ⟨i, rfl⟩
    change b (e i) ∈ Set.range b
    exact ⟨e i, rfl⟩
  let inclusion : tupleSubgroup (b ∘ e) →+ tupleSubgroup b :=
    AddSubgroup.inclusion hsource
  let f : tupleSubgroup (b ∘ e) →+ G :=
    (tupleSubgroup a).subtype.comp
      (g.equiv.toAddMonoidHom.comp inclusion)
  have hfinj : Function.Injective f := by
    intro x y hxy
    apply AddSubgroup.inclusion_injective hsource
    apply g.equiv.injective
    exact Subtype.ext hxy
  apply TupleIsoMap.ofInjectiveOnGenerators f hfinj
  intro i
  change (g.equiv
      (AddSubgroup.inclusion hsource
        ⟨b (e i), AddSubgroup.subset_closure (Set.mem_range_self i)⟩) : G) =
    a (e i)
  have hinc : AddSubgroup.inclusion hsource
      ⟨b (e i), AddSubgroup.subset_closure (Set.mem_range_self i)⟩ =
        ⟨b (e i), AddSubgroup.subset_closure (Set.mem_range_self (e i))⟩ := rfl
  rw [hinc, g.map_gen]

/-- Reindexing acts by the original tuple equivalence after inclusion of the
smaller generated subgroup. -/
@[simp] theorem TupleIsoMap.reindex_equiv_apply
    {m : ℕ} {a : Fin n → G} {b : Fin n → H}
    (g : TupleIsoMap a b) (e : Fin m → Fin n)
    (x : tupleSubgroup (b ∘ e)) :
    ((g.reindex e).equiv x : G) =
      (g.equiv
        (AddSubgroup.inclusion
          (by
            apply AddSubgroup.closure_mono
            rintro y ⟨i, rfl⟩
            exact ⟨e i, rfl⟩)
          x) : G) := by
  rfl

/-- An enlarged tuple isomorphism restricts to the unique map induced by the
original left block. -/
theorem TupleIsoMap.append_left_equiv_apply_eq
    {m : ℕ} {a : Fin n → G} {b : Fin n → H}
    {c : Fin m → G} {d : Fin m → H}
    (g : TupleIsoMap a b)
    (g' : TupleIsoMap (Fin.append a c) (Fin.append b d))
    (x : tupleSubgroup b) :
    (g.equiv x : G) =
      (g'.equiv
        (AddSubgroup.inclusion (tupleSubgroup_le_append_left b d) x) : G) := by
  let inclusion : tupleSubgroup b →+ tupleSubgroup (Fin.append b d) :=
    AddSubgroup.inclusion (tupleSubgroup_le_append_left b d)
  let P : ∀ y : H, y ∈ tupleSubgroup b → Prop := fun y hy ↦
    (g.equiv ⟨y, hy⟩ : G) = (g'.equiv (inclusion ⟨y, hy⟩) : G)
  change P (x : H) x.property
  refine AddSubgroup.closure_induction (p := P) ?_ ?_ ?_ ?_ x.property
  · intro y hy
    obtain ⟨i, rfl⟩ := hy
    have hg := congrArg Subtype.val (g.map_gen i)
    have hg' := congrArg Subtype.val (g'.map_gen (i.castAdd m))
    exact hg.trans (by simpa [inclusion] using hg'.symm)
  · change (g.equiv 0 : G) = (g'.equiv (inclusion 0) : G)
    simp
  · intro y z hy hz hyP hzP
    change (g.equiv (⟨y, hy⟩ + ⟨z, hz⟩) : G) =
      (g'.equiv (inclusion (⟨y, hy⟩ + ⟨z, hz⟩)) : G)
    rw [map_add, map_add, map_add]
    exact congrArg₂ (· + ·) hyP hzP
  · intro y hy hyP
    change (g.equiv (-⟨y, hy⟩) : G) =
      (g'.equiv (inclusion (-⟨y, hy⟩)) : G)
    rw [map_neg, map_neg, map_neg]
    exact congrArg Neg.neg hyP

end Tuples
