import Lib.PGroups.UlmInvariants
import Lib.Ulm.Pure

/-!
# Room, the jump space, and the two relative root lemmas

This file formalizes Section 1 of the paper *An Algebraic Characterization of the
Back and Forth Relations on Reduced Abelian `p`-Groups*: the definitions layer
that the back-and-forth characterization is stated in.

Throughout, `E` is a subgroup of `A` (the marked subgroup generated by a finite
tuple, in the application), `G_β = ulmSubgroup p β` is the height filtration, and
`P_β = pSocleAt p β` is the socle at height `β`.  The paper's convention
`h(x) ≥ β ↔ x ∈ G_β` is used to state the root lemmas by filtration membership
rather than through `ulmHeight`; `h(x) = β` becomes `x ∈ G_β ∧ x ∉ G_{β+1}`.

## Main definitions

- `room p E β`        : `R_{A,E}(β) = P_β / (E ∩ P_β)`            (Definition 1.1)
- `jumpSpace p E β`   : `S_{A,E}(β) = (pE ∩ G_{β+1}) / p(E ∩ G_β)` (Definition 1.3,
  called the jump space in current prose)

The Hill invariant of Definition 1.7 is already formalized upstream as
`hillInvariant` in `Lib.PGroups.UlmInvariants`, and properness (Definition 1.5)
as `IsProper` in `Lib.Ulm.Pure`.

## Main results

- `room_nontrivial_iff`      : `R_{A,E}(β) = 0 ↔ P_β ⊆ E`          (Proposition 1.2)
- `exists_root_notMem_iff`   : the relative root lemma             (Lemma 1.4)
- `isProper_iff_notMem_sup`  : Fuchs' criterion for properness     (Proposition 1.6)
- `exists_proper_root_iff`   : the exact relative root lemma       (Lemma 1.8)

Lemma 1.8 is obtained exactly as in the paper, by applying Lemma 1.4 to the
subgroup `E + G_{β+1}` and translating the three resulting pieces.

## References

- Fuchs, *Abelian Groups*, Springer Monographs in Mathematics, 2015, Chapter 11.
-/

open Ordinal

universe u

variable (p : ℕ) [hp : Fact p.Prime]
variable {G : Type u} [AddCommGroup G]

/-! ### Room (Definition 1.1) -/

/-- The room denominator `E ∩ P_β`, viewed as a subgroup of `P_β`. -/
noncomputable def roomDen (E : AddSubgroup G) (β : Ordinal.{0}) :
    AddSubgroup (pSocleAt p β (G := G)) :=
  (E ⊓ pSocleAt p β).comap (pSocleAt p β).subtype

/-- The room denominator as a `ZMod p`-submodule of `P_β`. -/
noncomputable def roomSubmodule (E : AddSubgroup G) (β : Ordinal.{0}) :
    Submodule (ZMod p) (pSocleAt p β (G := G)) :=
  AddSubgroup.toZModSubmodule p (roomDen p E β)

/-- The **room** of `E` at `β`: `R_{A,E}(β) = P_β / (E ∩ P_β)`, what is left of
`P_β` once `E` has taken `E ∩ P_β`. -/
abbrev room (E : AddSubgroup G) (β : Ordinal.{0}) : Type u :=
  (pSocleAt p β (G := G)) ⧸ roomSubmodule p E β

/-- The dimension of the room. -/
noncomputable def roomInvariant (E : AddSubgroup G) (β : Ordinal.{0}) : Cardinal :=
  Module.rank (ZMod p) (room p E β)

/-- The room denominator is everything exactly when `E` swallows `P_β`. -/
theorem roomSubmodule_eq_top_iff (E : AddSubgroup G) (β : Ordinal.{0}) :
    roomSubmodule p E β = ⊤ ↔ pSocleAt p β (G := G) ≤ E := by
  constructor
  · intro h x hx
    have hmem : (⟨x, hx⟩ : pSocleAt p β (G := G)) ∈ roomSubmodule p E β := by
      rw [h]; trivial
    exact hmem.1
  · intro h
    ext x
    simp only [Submodule.mem_top, iff_true]
    exact ⟨h x.property, x.property⟩

/-- **Proposition 1.2.** `R_{A,E}(β) = 0` if and only if `P_β ⊆ E`. -/
theorem room_subsingleton_iff (E : AddSubgroup G) (β : Ordinal.{0}) :
    Subsingleton (room p E β) ↔ pSocleAt p β (G := G) ≤ E :=
  Submodule.Quotient.subsingleton_iff.trans (roomSubmodule_eq_top_iff p E β)

/-- Proposition 1.2, in the contrapositive form used by the root lemmas. -/
theorem room_nontrivial_iff (E : AddSubgroup G) (β : Ordinal.{0}) :
    Nontrivial (room p E β) ↔ ¬ (pSocleAt p β (G := G) ≤ E) :=
  Submodule.Quotient.nontrivial_iff.trans (roomSubmodule_eq_top_iff p E β).not

/-! ### The jump space (Definition 1.3) -/

/-- The jump-space numerator `pE ∩ G_{β+1}`. -/
noncomputable def jumpNum (E : AddSubgroup G) (β : Ordinal.{0}) : AddSubgroup G :=
  pImage p E ⊓ ulmSubgroup p (Order.succ β)

/-- The jump-space denominator `p(E ∩ G_β)`. -/
noncomputable def jumpDen (E : AddSubgroup G) (β : Ordinal.{0}) : AddSubgroup G :=
  pImage p (E ⊓ ulmSubgroup p β)

omit hp in
/-- `pH ≤ H`. -/
lemma pImage_le (H : AddSubgroup G) : pImage p H ≤ H := by
  rintro x ⟨y, hy, rfl⟩
  simpa using H.nsmul_mem hy p

lemma jumpDen_le_jumpNum (E : AddSubgroup G) (β : Ordinal.{0}) :
    jumpDen p E β ≤ jumpNum p E β := by
  rintro x ⟨y, hy, rfl⟩
  refine ⟨⟨y, hy.1, rfl⟩, ?_⟩
  rw [ulmSubgroup_succ]
  exact ⟨y, hy.2, rfl⟩

/-- `p(E ∩ G_β)` viewed as a subgroup of `pE ∩ G_{β+1}`. -/
noncomputable def jumpDenIn (E : AddSubgroup G) (β : Ordinal.{0}) :
    AddSubgroup (jumpNum p E β) :=
  (jumpDen p E β).comap (jumpNum p E β).subtype

/-- The **jump space** `S_{A,E}(β) = (pE ∩ G_{β+1}) / p(E ∩ G_β)`. -/
abbrev jumpSpace (E : AddSubgroup G) (β : Ordinal.{0}) : Type u :=
  (jumpNum p E β) ⧸ jumpDenIn p E β

/-- The three-line check that makes the jump space a `ZMod p`-vector space:
its numerator need not consist of elements of order `p`, but `c ∈ pE ∩ G_{β+1}`
forces `c ∈ E ∩ G_β`, and hence `pc ∈ p(E ∩ G_β)`. -/
lemma smul_mem_jumpDen (E : AddSubgroup G) (β : Ordinal.{0}) {c : G}
    (hc : c ∈ jumpNum p E β) : p • c ∈ jumpDen p E β :=
  ⟨c, ⟨pImage_le p E hc.1, ulmSubgroup_antitone p (Order.le_succ β) hc.2⟩, rfl⟩

/-- Multiplication by `p` kills every class of the jump space, so it is a
`ZMod p`-vector space. -/
noncomputable instance jumpSpace_module (E : AddSubgroup G) (β : Ordinal.{0}) :
    Module (ZMod p) (jumpSpace p E β) := by
  classical
  refine QuotientAddGroup.zmodModule (n := p)
    (G := jumpNum p E β) (H := jumpDenIn p E β) ?_
  intro x
  have hx : ((p • x : jumpNum p E β) : G) = p • (x : G) := by simp
  show ((p • x : jumpNum p E β) : G) ∈ jumpDen p E β
  rw [hx]
  exact smul_mem_jumpDen p E β x.property

/-- The dimension of the jump space. -/
noncomputable def jumpInvariant (E : AddSubgroup G) (β : Ordinal.{0}) : Cardinal :=
  Module.rank (ZMod p) (jumpSpace p E β)

/-! ### Restriction to an earlier height -/

/-- A jump numerator at a later height is also a jump numerator at every
earlier height. -/
noncomputable def jumpNumRestriction (E : AddSubgroup G)
    {β γ : Ordinal.{0}} (hβγ : β ≤ γ) :
    jumpNum p E γ →+ jumpNum p E β where
  toFun c :=
    ⟨(c : G), ⟨c.property.1,
      ulmSubgroup_antitone p (Order.succ_le_succ hβγ) c.property.2⟩⟩
  map_zero' := Subtype.ext rfl
  map_add' _ _ := Subtype.ext rfl

/-- Later jump denominators map into earlier jump denominators. -/
lemma jumpDen_maps_restriction (E : AddSubgroup G)
    {β γ : Ordinal.{0}} (hβγ : β ≤ γ) :
    jumpDenIn p E γ ≤
      (jumpDenIn p E β).comap (jumpNumRestriction p E hβγ) := by
  rintro x ⟨y, hy, hpy⟩
  change (x : G) ∈ jumpDen p E β
  exact ⟨y, ⟨hy.1, ulmSubgroup_antitone p hβγ hy.2⟩, hpy⟩

/-- The canonical linear restriction `S_γ(E) → S_β(E)` for `β ≤ γ`. -/
noncomputable def jumpRestriction (E : AddSubgroup G)
    {β γ : Ordinal.{0}} (hβγ : β ≤ γ) :
    jumpSpace p E γ →ₗ[ZMod p] jumpSpace p E β :=
  (QuotientAddGroup.map (jumpDenIn p E γ) (jumpDenIn p E β)
    (jumpNumRestriction p E hβγ) (jumpDen_maps_restriction p E hβγ)).toZModLinearMap p

@[simp] theorem jumpRestriction_mk (E : AddSubgroup G)
    {β γ : Ordinal.{0}} (hβγ : β ≤ γ) (c : jumpNum p E γ) :
    jumpRestriction p E hβγ (QuotientAddGroup.mk c) =
      QuotientAddGroup.mk (jumpNumRestriction p E hβγ c) :=
  rfl

/-! ### The relative root lemma (Lemma 1.4) -/

/-- **Lemma 1.4 (relative root lemma).** For `E ≤ A`, `y ∈ A` and an ordinal `β`,
there is a `p`-th root `w` of `y` of height at least `β` lying outside `E` if and
only if `y ∈ G_{β+1}` and either `P_β ⊄ E` or `y ∉ p(E ∩ G_β)`. -/
theorem exists_root_notMem_iff (E : AddSubgroup G) (y : G) (β : Ordinal.{0}) :
    (∃ w : G, p • w = y ∧ w ∈ ulmSubgroup p β (G := G) ∧ w ∉ E) ↔
      y ∈ ulmSubgroup p (Order.succ β) (G := G) ∧
        (¬ (pSocleAt p β (G := G) ≤ E) ∨ y ∉ jumpDen p E β) := by
  constructor
  · rintro ⟨w, rfl, hwβ, hwE⟩
    refine ⟨by rw [ulmSubgroup_succ]; exact ⟨w, hwβ, rfl⟩, ?_⟩
    by_contra hcon
    push Not at hcon
    obtain ⟨hPE, hy⟩ := hcon
    obtain ⟨z, hz, hpz⟩ := hy
    have hsub : w - z ∈ pSocleAt p β (G := G) := by
      refine ⟨?_, (ulmSubgroup p β).sub_mem hwβ hz.2⟩
      show p • (w - z) = 0
      rw [smul_sub, hpz]
      simp
    exact hwE (by simpa using E.add_mem (hPE hsub) hz.1)
  · rintro ⟨hy, hdisj⟩
    obtain ⟨w, hwβ, rfl⟩ := (mem_ulmSubgroup_succ_iff p β y).1 hy
    by_cases hwE : w ∈ E
    · rcases hdisj with hP | hy'
      · obtain ⟨z, hzP, hzE⟩ := SetLike.not_le_iff_exists.mp hP
        refine ⟨w + z, ?_, (ulmSubgroup p β).add_mem hwβ hzP.2, ?_⟩
        · have hz0 : p • z = 0 := hzP.1
          rw [smul_add, hz0, add_zero]
        · intro hcon
          exact hzE (by simpa using E.sub_mem hcon hwE)
      · exact absurd (⟨w, ⟨hwE, hwβ⟩, rfl⟩ : p • w ∈ jumpDen p E β) hy'
    · exact ⟨w, rfl, hwβ, hwE⟩

/-! ### Properness (Definition 1.5) and Fuchs' criterion (Proposition 1.6) -/

/-- Ulm height strictly above `β` means membership in `G_{β+1}`.  This is the
contrapositive of `ulmHeight_le_of_not_mem_succ`. -/
lemma mem_ulmSubgroup_succ_of_lt_ulmHeight (x : G) (β : Ordinal.{0})
    (h : (β : WithTop Ordinal.{0}) < ulmHeight p x) :
    x ∈ ulmSubgroup p (Order.succ β) (G := G) := by
  by_contra hx
  exact absurd (ulmHeight_le_of_not_mem_succ p x β hx) (not_le.mpr h)

/-- **Proposition 1.6 (Fuchs).** For `x` of height exactly `β`, that is, with
`x ∈ G_β` and `x ∉ G_{β+1}`, properness with respect to `E` is the same as
`x ∉ E + G_{β+1}`. -/
theorem isProper_iff_notMem_sup (E : AddSubgroup G) (x : G) (β : Ordinal.{0})
    (hx : x ∈ ulmSubgroup p β (G := G))
    (hxs : x ∉ ulmSubgroup p (Order.succ β) (G := G)) :
    IsProper p E x ↔ x ∉ E ⊔ ulmSubgroup p (Order.succ β) (G := G) := by
  have hβ : ulmHeight p x = (β : WithTop Ordinal.{0}) :=
    ulmHeight_eq_of_mem_not_mem_succ p x β hx hxs
  constructor
  · intro hprop hmem
    obtain ⟨e, he, g, hg, hxeg⟩ := AddSubgroup.mem_sup.mp hmem
    have hle : ulmHeight p (x + -e) ≤ ulmHeight p x := hprop ⟨-e, E.neg_mem he⟩
    have hxe : x + -e = g := by rw [← hxeg]; abel
    rw [hxe, hβ] at hle
    have hgge : ((Order.succ β : Ordinal.{0}) : WithTop Ordinal.{0}) ≤ ulmHeight p g :=
      coe_le_ulmHeight_of_mem p g (Order.succ β) hg
    exact absurd (WithTop.coe_le_coe.mp (hgge.trans hle)) (not_le.mpr (Order.lt_succ β))
  · intro hmem s
    rw [hβ]
    by_contra hlt
    push Not at hlt
    exact hmem (AddSubgroup.mem_sup.mpr
      ⟨-(s : G), E.neg_mem s.property, x + s,
        mem_ulmSubgroup_succ_of_lt_ulmHeight p (x + s) β hlt, by abel⟩)

/-! ### The exact relative root lemma (Lemma 1.8) -/

/-- Translation (ii) of the paper's proof: the room of `E + G_{β+1}` at `β` and the
Hill invariant of `E` at `β` have literally the same denominator. -/
lemma roomSubmodule_sup_eq_hillSubmodule (E : AddSubgroup G) (β : Ordinal.{0}) :
    roomSubmodule p (E ⊔ ulmSubgroup p (Order.succ β)) β = hillSubmodule p E β := by
  unfold roomSubmodule hillSubmodule roomDen hillDen
  rw [inf_comm]

/-- The Hill denominator is everything exactly when `E + G_{β+1}` swallows `P_β`.
This is Proposition 1.2 read at the subgroup `E + G_{β+1}`. -/
theorem hillSubmodule_eq_top_iff (E : AddSubgroup G) (β : Ordinal.{0}) :
    hillSubmodule p E β = ⊤ ↔
      pSocleAt p β (G := G) ≤ E ⊔ ulmSubgroup p (Order.succ β) := by
  rw [← roomSubmodule_sup_eq_hillSubmodule]
  exact roomSubmodule_eq_top_iff p _ β

/-- The Hill space of `E` at `β` is nonzero exactly when `P_β ⊄ E + G_{β+1}`. -/
theorem hillQuotient_nontrivial_iff (E : AddSubgroup G) (β : Ordinal.{0}) :
    Nontrivial (hillQuotient p E β) ↔
      ¬ (pSocleAt p β (G := G) ≤ E ⊔ ulmSubgroup p (Order.succ β)) :=
  Submodule.Quotient.nontrivial_iff.trans (hillSubmodule_eq_top_iff p E β).not

omit hp in
lemma pImage_sup (A B : AddSubgroup G) :
    pImage p (A ⊔ B) = pImage p A ⊔ pImage p B := by
  apply le_antisymm
  · rintro x ⟨y, hy, rfl⟩
    obtain ⟨a, ha, b, hb, rfl⟩ := AddSubgroup.mem_sup.mp hy
    rw [smul_add]
    exact AddSubgroup.add_mem _
      (AddSubgroup.mem_sup_left ⟨a, ha, rfl⟩)
      (AddSubgroup.mem_sup_right ⟨b, hb, rfl⟩)
  · refine sup_le ?_ ?_
    · rintro x ⟨y, hy, rfl⟩
      exact ⟨y, AddSubgroup.mem_sup_left hy, rfl⟩
    · rintro x ⟨y, hy, rfl⟩
      exact ⟨y, AddSubgroup.mem_sup_right hy, rfl⟩

/-- Translation (iii) of the paper's proof, by the Dedekind modular law together
with `pG_{β+1} = G_{β+2}`:
`p((E + G_{β+1}) ∩ G_β) = p(E ∩ G_β) + G_{β+2}`. -/
lemma jumpDen_sup_eq (E : AddSubgroup G) (β : Ordinal.{0}) :
    jumpDen p (E ⊔ ulmSubgroup p (Order.succ β)) β =
      jumpDen p E β ⊔ ulmSubgroup p (Order.succ (Order.succ β)) (G := G) := by
  have hmod : (E ⊔ ulmSubgroup p (Order.succ β) (G := G)) ⊓ ulmSubgroup p β
      = ulmSubgroup p (Order.succ β) ⊔ (E ⊓ ulmSubgroup p β) := by
    rw [sup_comm]
    exact sup_inf_assoc_of_le E (ulmSubgroup_antitone p (Order.le_succ β))
  unfold jumpDen
  rw [hmod, pImage_sup, ← ulmSubgroup_succ, sup_comm]

/-- **Lemma 1.8 (exact relative root lemma).** For `E ≤ A`, `y ∈ A` and an ordinal
`β`, there is a `p`-th root `w` of `y` of height exactly `β` that is proper with
respect to `E` if and only if `y ∈ G_{β+1}` and either the Hill invariant
`f_{A,E}(β)` is nonzero or `y ∉ p(E ∩ G_β) + G_{β+2}`. -/
theorem exists_proper_root_iff (E : AddSubgroup G) (y : G) (β : Ordinal.{0}) :
    (∃ w : G, p • w = y ∧ w ∈ ulmSubgroup p β (G := G) ∧
        w ∉ ulmSubgroup p (Order.succ β) (G := G) ∧ IsProper p E w) ↔
      y ∈ ulmSubgroup p (Order.succ β) (G := G) ∧
        (Nontrivial (hillQuotient p E β) ∨
          y ∉ jumpDen p E β ⊔ ulmSubgroup p (Order.succ (Order.succ β)) (G := G)) := by
  have hL : (∃ w : G, p • w = y ∧ w ∈ ulmSubgroup p β (G := G) ∧
        w ∉ ulmSubgroup p (Order.succ β) (G := G) ∧ IsProper p E w) ↔
      (∃ w : G, p • w = y ∧ w ∈ ulmSubgroup p β (G := G) ∧
        w ∉ E ⊔ ulmSubgroup p (Order.succ β) (G := G)) := by
    constructor
    · rintro ⟨w, hpw, hwβ, hws, hprop⟩
      exact ⟨w, hpw, hwβ, (isProper_iff_notMem_sup p E w β hwβ hws).mp hprop⟩
    · rintro ⟨w, hpw, hwβ, hwE'⟩
      have hws : w ∉ ulmSubgroup p (Order.succ β) (G := G) := fun h =>
        hwE' (AddSubgroup.mem_sup_right h)
      exact ⟨w, hpw, hwβ, hws, (isProper_iff_notMem_sup p E w β hwβ hws).mpr hwE'⟩
  rw [hL, exists_root_notMem_iff p (E ⊔ ulmSubgroup p (Order.succ β)) y β,
    hillQuotient_nontrivial_iff, jumpDen_sup_eq]

/-- A nonzero standard-Hill invariant supplies the proper exact-height root in
the gap branch of the relative root lemma.  This is the quotient-level form
used by the exact-even countdown: no ambient Ulm comparison is needed. -/
theorem exists_proper_root_of_hillInvariant_pos
    (E : AddSubgroup G) (y : G) (β : Ordinal.{0})
    (hy : y ∈ ulmSubgroup p (Order.succ β) (G := G))
    (hhill : 0 < hillInvariant p E β) :
    ∃ w : G, p • w = y ∧
      w ∈ ulmSubgroup p β (G := G) ∧
      w ∉ ulmSubgroup p (Order.succ β) (G := G) ∧
      IsProper p E w := by
  apply (exists_proper_root_iff p E y β).2
  exact ⟨hy, Or.inl ((rank_pos_iff_nontrivial (R := ZMod p)).1 hhill)⟩

/-! ### When the jump space collapses -/

/-- If `E` already lies inside `G_β`, its jump space at `β` is trivial.

The denominator `p(E ∩ G_β)` then equals `pE`, which already contains the
numerator `pE ∩ G_{β+1}`.  This is the cheap half of exhibiting a non-injective
induced map: it makes a target jump space collapse without any computation. -/
theorem jumpSpace_subsingleton_of_le (E : AddSubgroup G) (β : Ordinal.{0})
    (hE : E ≤ ulmSubgroup p β (G := G)) :
    Subsingleton (jumpSpace p E β) := by
  have hden : jumpDen p E β = pImage p E := by
    unfold jumpDen
    congr 1
    exact inf_eq_left.mpr hE
  constructor
  intro x y
  induction x using QuotientAddGroup.induction_on with
  | H c =>
    induction y using QuotientAddGroup.induction_on with
    | H d =>
      apply QuotientAddGroup.eq.mpr
      show (-(c : G) + (d : G)) ∈ jumpDen p E β
      rw [hden]
      exact (pImage p E).add_mem ((pImage p E).neg_mem c.2.1) d.2.1

/-- If `E` contains the whole tail `G_β`, then its jump space at `β` is
trivial.

Every numerator element has a root in `G_β`; the tail-containment hypothesis
puts that root in `E`, so the element already lies in the jump denominator.  This
is the algebraic zero branch used after the finite tail has been absorbed. -/
theorem jumpSpace_subsingleton_of_ulmSubgroup_le (E : AddSubgroup G)
    (β : Ordinal.{0}) (hE : ulmSubgroup p β (G := G) ≤ E) :
    Subsingleton (jumpSpace p E β) := by
  rw [QuotientAddGroup.subsingleton_iff]
  ext c
  simp only [AddSubgroup.mem_top, iff_true]
  obtain ⟨z, hz, hzc⟩ := (mem_ulmSubgroup_succ_iff p β (c : G)).mp c.property.2
  exact ⟨z, ⟨hE hz, hz⟩, hzc⟩
