import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Finite linear Rado theorem

This file isolates the finite-dimensional linear-algebra theorem used by the
height--Rado construction.  A family of access sets has an independent
transversal exactly when every subfamily spans at least as many dimensions as
it has members.

The sufficiency proof is the standard induction.  A proper tight subfamily is
solved first and the remaining problem is passed to the quotient by its span.
If there is no proper tight subfamily, choose one representative and pass the
remaining family to the quotient by its line.
-/

noncomputable section

open Function Module Set Submodule

universe u v w x

namespace FiniteRado

variable {K : Type u} {V : Type v} {ι : Type w}
variable [DivisionRing K] [AddCommGroup V] [Module K V]

/-- The union of the access sets indexed by `s`. -/
def familyUnion (D : ι → Set V) (s : Finset ι) : Set V :=
  ⋃ i ∈ (s : Set ι), D i

/-- The subspace generated by the access sets indexed by `s`. -/
def familySpan (D : ι → Set V) (s : Finset ι) : Submodule K V :=
  span K (familyUnion D s)

/-- Rado's rank inequalities on all subfamilies of `s`. -/
def ConditionOn (D : ι → Set V) (s : Finset ι) : Prop :=
  ∀ t : Finset ι, t ⊆ s → t.card ≤ Module.finrank K (familySpan (K := K) D t)

/-- An independent choice from every access set indexed by `s`.  The selector
is kept as a function on the ambient index type so that restrictions and
piecewise combinations do not require transports between subtype functions. -/
def HasIndependentTransversalOn (D : ι → Set V) (s : Finset ι) : Prop :=
  ∃ f : ι → V, (∀ i ∈ s, f i ∈ D i) ∧ LinearIndepOn K f (s : Set ι)

omit [AddCommGroup V] in
lemma mem_familyUnion_of_mem {D : ι → Set V} {s : Finset ι} {i : ι}
    (hi : i ∈ s) {x : V} (hx : x ∈ D i) : x ∈ familyUnion D s := by
  simp only [familyUnion, Set.mem_iUnion]
  exact ⟨i, hi, hx⟩

omit [AddCommGroup V] in
lemma familyUnion_mono {D : ι → Set V} {s t : Finset ι} (hst : s ⊆ t) :
    familyUnion D s ⊆ familyUnion D t := by
  intro x hx
  simp only [familyUnion, Set.mem_iUnion] at hx ⊢
  obtain ⟨i, hi, hxi⟩ := hx
  exact ⟨i, hst hi, hxi⟩

lemma familySpan_mono {D : ι → Set V} {s t : Finset ι} (hst : s ⊆ t) :
    familySpan (K := K) D s ≤ familySpan D t :=
  span_mono (familyUnion_mono hst)

omit [AddCommGroup V] in
lemma familyUnion_union [DecidableEq ι] (D : ι → Set V) (s t : Finset ι) :
    familyUnion D (s ∪ t) = familyUnion D s ∪ familyUnion D t := by
  classical
  ext x
  simp only [familyUnion, Set.mem_iUnion, Set.mem_union]
  constructor
  · rintro ⟨i, hi, hxi⟩
    have hi' : i ∈ s ∪ t := hi
    rcases Finset.mem_union.mp hi' with hi | hi
    · exact Or.inl ⟨i, hi, hxi⟩
    · exact Or.inr ⟨i, hi, hxi⟩
  · rintro (⟨i, hi, hxi⟩ | ⟨i, hi, hxi⟩)
    · exact ⟨i, Finset.mem_union.mpr (Or.inl hi), hxi⟩
    · exact ⟨i, Finset.mem_union.mpr (Or.inr hi), hxi⟩

lemma familySpan_union [DecidableEq ι] (D : ι → Set V) (s t : Finset ι) :
    familySpan (K := K) D (s ∪ t) = familySpan D s ⊔ familySpan D t := by
  classical
  rw [familySpan, familyUnion_union, span_union]
  rfl

/-- Rank-nullity for the image of a subspace in a quotient. -/
lemma finrank_map_mkQ_add_finrank_inf [FiniteDimensional K V]
    (W S : Submodule K V) :
    Module.finrank K (S.map W.mkQ) +
        Module.finrank K (S ⊓ W : Submodule K V) =
      Module.finrank K S := by
  let f := W.mkQ.domRestrict S
  have h := LinearMap.finrank_range_add_finrank_ker f
  rw [LinearMap.range_domRestrict, LinearMap.ker_domRestrict,
    Submodule.ker_mkQ] at h
  have hker : Module.finrank K (W.comap S.subtype) =
      Module.finrank K (S ⊓ W : Submodule K V) := by
    calc
      Module.finrank K (W.comap S.subtype) =
          Module.finrank K ((W.comap S.subtype).map S.subtype) :=
        (Submodule.finrank_map_subtype_eq S (W.comap S.subtype)).symm
      _ = Module.finrank K (S ⊓ W : Submodule K V) := by
        rw [Submodule.map_comap_subtype]
  simpa [f, hker] using h

/-- The span of a subfamily after quotienting is the image of its original
span. -/
lemma familySpan_image_mkQ [FiniteDimensional K V]
    (D : ι → Set V) (W : Submodule K V) (s : Finset ι) :
    familySpan (K := K) (fun i ↦ W.mkQ '' D i) s =
      (familySpan (K := K) D s).map W.mkQ := by
  classical
  rw [familySpan, familySpan, Submodule.map_span]
  apply congrArg (span K)
  ext x
  simp only [familyUnion, Set.mem_iUnion, Set.mem_image]
  constructor
  · rintro ⟨i, hi, y, hy, rfl⟩
    exact ⟨y, ⟨i, hi, hy⟩, rfl⟩
  · rintro ⟨y, ⟨i, hi, hy⟩, rfl⟩
    exact ⟨i, hi, y, hy, rfl⟩

/-- Every independent transversal satisfies the Rado inequalities. -/
theorem conditionOn_of_hasIndependentTransversalOn [FiniteDimensional K V]
    {D : ι → Set V} {s : Finset ι}
    (h : HasIndependentTransversalOn (K := K) D s) : ConditionOn (K := K) D s := by
  classical
  obtain ⟨f, hfD, hfind⟩ := h
  intro t hts
  let b : t → familySpan (K := K) D t := fun i ↦
    ⟨f i, subset_span (mem_familyUnion_of_mem i.property (hfD i (hts i.property)))⟩
  have hb : LinearIndependent K b := by
    apply LinearIndependent.of_comp (familySpan (K := K) D t).subtype
    simpa [b, Function.comp_def] using hfind.mono (by simpa using hts)
  simpa [Fintype.card_coe] using hb.fintype_card_le_finrank

/-- The finite-dimensional linear form of Rado's independent-transversal
theorem. -/
theorem hasIndependentTransversalOn_of_conditionOn [FiniteDimensional K V]
    {D : ι → Set V} {s : Finset ι}
    (hcond : ConditionOn (K := K) D s) :
    HasIndependentTransversalOn (K := K) D s := by
  classical
  induction hn : s.card using Nat.strong_induction_on generalizing V ι s D with
  | h n ih =>
      by_cases hs : s = ∅
      · subst s
        exact ⟨fun _ ↦ 0, by simp, by simp⟩
      by_cases htight : ∃ t : Finset ι,
          t ⊂ s ∧ t.Nonempty ∧
            Module.finrank K (familySpan (K := K) D t) = t.card
      · obtain ⟨t, hts, htne, htight⟩ := htight
        have hcond_t : ConditionOn (K := K) D t := by
          intro u hut
          exact hcond u (hut.trans hts.1)
        obtain ⟨fT, hfTD, hfTind⟩ :=
          ih t.card (by simpa [hn] using Finset.card_lt_card hts)
            (V := V) (ι := ι) (s := t) (D := D) hcond_t rfl
        let W := familySpan (K := K) D t
        let Tspan := span K (fT '' (t : Set ι))
        have hTspan_le : Tspan ≤ W := by
          apply span_le.mpr
          rintro x ⟨i, hi, rfl⟩
          exact subset_span (mem_familyUnion_of_mem hi (hfTD i hi))
        have hfTfamily : LinearIndependent K (fun i : t ↦ fT i) := by
          simpa [LinearIndepOn, Function.comp_def] using hfTind
        have hfinTspan : Module.finrank K Tspan = t.card := by
          have hrange : Set.range (fun i : t ↦ fT i) = fT '' (t : Set ι) := by
            ext x
            constructor
            · rintro ⟨i, rfl⟩
              exact ⟨i, i.property, rfl⟩
            · rintro ⟨i, hi, rfl⟩
              exact ⟨⟨i, hi⟩, rfl⟩
          change Module.finrank K (span K (fT '' (t : Set ι))) = t.card
          rw [← hrange]
          simpa [Fintype.card_coe] using finrank_span_eq_card hfTfamily
        have hTspan : Tspan = W := by
          apply Submodule.eq_of_le_of_finrank_eq hTspan_le
          rw [hfinTspan, htight]
        let c := s \ t
        let Dq : ι → Set (V ⧸ W) := fun i ↦ W.mkQ '' D i
        have hcond_c : ConditionOn (K := K) Dq c := by
          intro u huc
          have hut_disj : Disjoint t u := by
            apply Finset.disjoint_left.mpr
            intro i hit hiu
            have hiuc : i ∈ c := huc hiu
            exact (Finset.mem_sdiff.mp hiuc).2 hit
          have htus : t ∪ u ⊆ s := by
            intro i hi
            rcases Finset.mem_union.mp hi with hit | hiu
            · exact hts.1 hit
            · exact (Finset.mem_sdiff.mp (huc hiu)).1
          have htu := hcond (t ∪ u) htus
          have hcard : (t ∪ u).card = t.card + u.card :=
            Finset.card_union_of_disjoint hut_disj
          have hrank := finrank_map_mkQ_add_finrank_inf (K := K) W
            (W ⊔ familySpan (K := K) D u)
          have hrank' :
              Module.finrank K
                  ((familySpan (K := K) D u).map W.mkQ) +
                Module.finrank K W =
                  Module.finrank K
                    (W ⊔ familySpan (K := K) D u : Submodule K V) := by
            have hmap :
                (W ⊔ familySpan (K := K) D u : Submodule K V).map W.mkQ =
                  (familySpan (K := K) D u).map W.mkQ := by
              rw [Submodule.map_sup, Submodule.mkQ_map_self, bot_sup_eq]
            have hinf :
                (W ⊔ familySpan (K := K) D u : Submodule K V) ⊓ W = W :=
              inf_eq_right.mpr le_sup_left
            rw [hmap, hinf] at hrank
            exact hrank
          rw [hcard, familySpan_union] at htu
          rw [familySpan_image_mkQ]
          have hWrank : Module.finrank K W = t.card := by
            simpa [W] using htight
          have hbound :
              t.card + u.card ≤
                Module.finrank K ((familySpan (K := K) D u).map W.mkQ) +
                  Module.finrank K W := by
            rw [hrank']
            simpa [W] using htu
          rw [hWrank] at hbound
          omega
        have hc_lt : c.card < n := by
          have hcs : c ⊂ s := Finset.sdiff_ssubset hts.1 htne
          simpa [hn] using Finset.card_lt_card hcs
        obtain ⟨fQ, hfQD, hfQind⟩ :=
          ih c.card hc_lt (V := V ⧸ W) (ι := ι) (s := c) (D := Dq) hcond_c rfl
        let fC : ι → V := fun i ↦
          if hi : i ∈ c then Classical.choose (hfQD i hi) else 0
        have hfCD (i : ι) (hi : i ∈ c) : fC i ∈ D i := by
          dsimp only [fC]
          rw [dif_pos hi]
          exact (Classical.choose_spec (hfQD i hi)).1
        have hfCQ (i : ι) (hi : i ∈ c) : W.mkQ (fC i) = fQ i := by
          dsimp only [fC]
          rw [dif_pos hi]
          exact (Classical.choose_spec (hfQD i hi)).2
        let f : ι → V := fun i ↦ if hi : i ∈ t then fT i else fC i
        refine ⟨f, ?_, ?_⟩
        · intro i his
          by_cases hit : i ∈ t
          · simpa [f, hit] using hfTD i hit
          · have hic : i ∈ c := Finset.mem_sdiff.mpr ⟨his, hit⟩
            simpa [f, hit] using hfCD i hic
        · have hf_on_t : LinearIndepOn K f (t : Set ι) :=
            hfTind.congr (by
              intro i hi
              have hit : i ∈ t := hi
              simp [f, hit])
          have hspan_f : span K (f '' (t : Set ι)) = W := by
            calc
              span K (f '' (t : Set ι)) = Tspan := by
                apply congrArg (span K)
                apply Set.image_congr
                intro i hi
                have hit : i ∈ t := hi
                simp [f, hit]
              _ = W := hTspan
          have hfQ_on_c : LinearIndepOn K (W.mkQ ∘ f) (c : Set ι) :=
            hfQind.congr (by
              intro i hi
              have hit : i ∉ t := (Finset.mem_sdiff.mp hi).2
              simp [f, hit, hfCQ i hi])
          have hfQ_on_c' :
              LinearIndepOn K ((span K (f '' (t : Set ι))).mkQ ∘ f)
                (c : Set ι) := by
            rw [hspan_f]
            exact hfQ_on_c
          have h_union := hf_on_t.union_of_quotient hfQ_on_c'
          have htc : (t : Set ι) ∪ (c : Set ι) = (s : Set ι) := by
            ext i
            constructor
            · rintro (hit | hic)
              · exact hts.1 hit
              · exact (Finset.mem_sdiff.mp hic).1
            · intro his
              by_cases hit : i ∈ t
              · exact Or.inl hit
              · exact Or.inr (Finset.mem_sdiff.mpr ⟨his, hit⟩)
          simpa [htc] using h_union
      · obtain ⟨i0, hi0⟩ : s.Nonempty := Finset.nonempty_iff_ne_empty.mpr hs
        have hex : ∃ x ∈ D i0, x ≠ 0 := by
          by_contra h
          push Not at h
          have hspan0 : familySpan (K := K) D {i0} = ⊥ := by
            apply le_antisymm
            · apply span_le.mpr
              intro y hy
              have hyD : y ∈ D i0 := by
                simpa [familySpan, familyUnion] using hy
              have hy0 := h y hyD
              simp [hy0]
            · exact bot_le
          have hsingle := hcond {i0} (by simp [hi0])
          rw [hspan0, finrank_bot] at hsingle
          simp at hsingle
        obtain ⟨x, hxD, hx0⟩ := hex
        let W := span K ({x} : Set V)
        have hWrank : Module.finrank K W = 1 := by
          simpa [W] using finrank_span_singleton hx0
        let c := s.erase i0
        let Dq : ι → Set (V ⧸ W) := fun i ↦ W.mkQ '' D i
        have hcond_c : ConditionOn (K := K) Dq c := by
          intro u huc
          by_cases hu0 : u = ∅
          · subst u
            simp [familySpan, familyUnion]
          have hune : u.Nonempty := Finset.nonempty_iff_ne_empty.mpr hu0
          have hus : u ⊆ s := huc.trans (Finset.erase_subset i0 s)
          have hi0u : i0 ∉ u := by
            intro hiu
            exact (Finset.mem_erase.mp (huc hiu)).1 rfl
          have hus_strict : u ⊂ s := ⟨hus, by
            intro hsu
            exact hi0u (hsu hi0)⟩
          have hle := hcond u hus
          have hne : Module.finrank K (familySpan (K := K) D u) ≠ u.card := by
            intro heq
            exact htight ⟨u, hus_strict, hune, heq⟩
          have hstrict : u.card + 1 ≤
              Module.finrank K (familySpan (K := K) D u) := by
            omega
          have hrank := finrank_map_mkQ_add_finrank_inf (K := K) W
            (familySpan (K := K) D u)
          have hinf_le :
              Module.finrank K
                  (familySpan (K := K) D u ⊓ W : Submodule K V) ≤
                Module.finrank K W :=
            Submodule.finrank_mono inf_le_right
          rw [familySpan_image_mkQ]
          omega
        have hc_lt : c.card < n := by
          have hcs : c ⊂ s := Finset.erase_ssubset hi0
          simpa [hn] using Finset.card_lt_card hcs
        obtain ⟨fQ, hfQD, hfQind⟩ :=
          ih c.card hc_lt (V := V ⧸ W) (ι := ι) (s := c) (D := Dq) hcond_c rfl
        let fC : ι → V := fun i ↦
          if hi : i ∈ c then Classical.choose (hfQD i hi) else 0
        have hfCD (i : ι) (hi : i ∈ c) : fC i ∈ D i := by
          dsimp only [fC]
          rw [dif_pos hi]
          exact (Classical.choose_spec (hfQD i hi)).1
        have hfCQ (i : ι) (hi : i ∈ c) : W.mkQ (fC i) = fQ i := by
          dsimp only [fC]
          rw [dif_pos hi]
          exact (Classical.choose_spec (hfQD i hi)).2
        let f : ι → V := fun i ↦ if i = i0 then x else fC i
        refine ⟨f, ?_, ?_⟩
        · intro i his
          by_cases hii : i = i0
          · subst i
            simpa [f] using hxD
          · have hic : i ∈ c := Finset.mem_erase.mpr ⟨hii, his⟩
            simpa [f, hii] using hfCD i hic
        · have hf_on_singleton : LinearIndepOn K f ({i0} : Set ι) := by
            rw [linearIndepOn_singleton_iff]
            simpa [f] using hx0
          have hspan_f : span K (f '' ({i0} : Set ι)) = W := by
            have himage : f '' ({i0} : Set ι) = ({x} : Set V) := by
              ext y
              simp [f]
            rw [himage]
          have hfQ_on_c : LinearIndepOn K (W.mkQ ∘ f) (c : Set ι) :=
            hfQind.congr (by
              intro i hi
              have hii : i ≠ i0 := (Finset.mem_erase.mp hi).1
              simp [f, hii, hfCQ i hi])
          have hfQ_on_c' :
              LinearIndepOn K ((span K (f '' ({i0} : Set ι))).mkQ ∘ f)
                (c : Set ι) := by
            rw [hspan_f]
            exact hfQ_on_c
          have h_union := hf_on_singleton.union_of_quotient hfQ_on_c'
          have hsc : ({i0} : Set ι) ∪ (c : Set ι) = (s : Set ι) := by
            ext i
            constructor
            · rintro (hi | hic)
              · have hii : i = i0 := by simpa using hi
                subst i
                exact hi0
              · exact (Finset.mem_erase.mp hic).2
            · intro his
              by_cases hii : i = i0
              · subst i
                exact Or.inl (by simp)
              · exact Or.inr (Finset.mem_erase.mpr ⟨hii, his⟩)
          simpa [hsc] using h_union

/-- Rado's condition for a family indexed by a finite type. -/
def Condition [Fintype ι] (D : ι → Set V) : Prop :=
  ConditionOn (K := K) D Finset.univ

/-- An independent transversal for a family indexed by a finite type. -/
def HasIndependentTransversal [Fintype ι] (D : ι → Set V) : Prop :=
  HasIndependentTransversalOn (K := K) D Finset.univ

/-- **Finite linear Rado theorem.**  A finite family of subsets of a
finite-dimensional vector space has an independent transversal iff every
subfamily spans at least its cardinality. -/
theorem finite_linear_rado [Fintype ι] [FiniteDimensional K V]
    (D : ι → Set V) :
    HasIndependentTransversal (K := K) D ↔ Condition (K := K) D :=
  ⟨conditionOn_of_hasIndependentTransversalOn,
    hasIndependentTransversalOn_of_conditionOn⟩

section BasisRealization

variable {Q : Type x} [AddCommGroup Q] [Module K Q]

/-- A full-rank realization of access sets, expressed intrinsically as an
injective linear map whose value on each source basis vector lies in the
corresponding access set. -/
def HasInjectiveRealization [Fintype ι] (b : Basis ι K Q)
    (D : ι → Set V) : Prop :=
  ∃ L : Q →ₗ[K] V, Function.Injective L ∧ ∀ i, L (b i) ∈ D i

/-- Rado's independent transversal is equivalently an injective linear map on
the source space with the prescribed access sets on a basis. -/
theorem hasInjectiveRealization_iff [Fintype ι] [FiniteDimensional K V]
    [SMulCommClass K K V]
    (b : Basis ι K Q) (D : ι → Set V) :
    HasInjectiveRealization b D ↔ Condition (K := K) D := by
  constructor
  · rintro ⟨L, hL, hLD⟩
    apply conditionOn_of_hasIndependentTransversalOn
    refine ⟨fun i ↦ L (b i), ?_, ?_⟩
    · intro i _
      exact hLD i
    · have hli : LinearIndependent K (fun i ↦ L (b i)) :=
        b.linearIndependent.map_injOn L hL.injOn
      simpa using hli.linearIndepOn_univ
  · intro hcond
    obtain ⟨f, hfD, hfind⟩ :=
      hasIndependentTransversalOn_of_conditionOn hcond
    let L : Q →ₗ[K] V := b.constr K f
    have hfind' : LinearIndependent K f := by
      apply linearIndepOn_univ_iff.mp
      simpa using hfind
    have hL : Function.Injective L := by
      intro x y hxy
      apply b.repr.injective
      apply hfind'
      simpa only [L, Basis.constr_apply, Finsupp.linearCombination_apply] using hxy
    refine ⟨L, hL, ?_⟩
    intro i
    rw [show L (b i) = f i by exact b.constr_basis K f i]
    exact hfD i (Finset.mem_univ i)

end BasisRealization

end FiniteRado
