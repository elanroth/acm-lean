import Lib.BackForth.EvenToOdd
import Lib.BackForth.ExactStageTransfer
import Lib.BackForth.FiniteEmbedding

/-!
# The finite high countdown in the even response

The high phase of ACM Case 2 is not a height-floor embedding.  It preserves
the filtration exactly below a moving finite cutoff, while a source element
which survives to the end of the omega window is sent only high enough for
the remaining finite construction.  Each one-generator extension lowers that
target cutoff by one.

This file keeps that mechanism separate from the final tuple response.  The
low branch uses the existing cutoff-local Kaplansky selection.  The high
branch repairs a small gap in the printed proof: its fresh filtered-socle
element is chosen outside the subgroup generated by both the old range and a
chosen root, not merely outside the old range.
-/

noncomputable section

open Ordinal

universe u


variable (p : ℕ) [Fact p.Prime]

namespace EvenHighCountdown

variable {G H : Type u} [AddCommGroup G] [AddCommGroup H]
variable {n : ℕ}

/-- The small interface actually consumed by the finite even countdown.

The established crossed package and the exact Hill--room candidate supply
different proofs of `select_low`, while the countdown bookkeeping itself is
identical. -/
structure Context
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    (α : Ordinal.{0}) (a : Fin n → G) (b : Fin n → H) : Type u where
  iso : TupleIsoMap a b
  lengths :
    ((ulmLength p (G := G) hG : Ordinal.{0}) =
        (ulmLength p (G := H) hH : Ordinal.{0}) ∧
      (ulmLength p (G := G) hG : Ordinal.{0}) < ω * α + ω) ∨
    (ω * α + ω ≤ (ulmLength p (G := G) hG : Ordinal.{0}) ∧
      ω * α + ω ≤ (ulmLength p (G := H) hH : Ordinal.{0}))
  ulm_below : ∀ β : Ordinal.{0}, β < ω * α →
    ulmInvariant p β (G := H) = ulmInvariant p β (G := G)
  presBelowCap :
    IsHeightPresBelowOn p iso.equiv.toAddMonoidHom (ω * α + ω)
  select_low : ∀ {S : AddSubgroup H},
    Set.Finite (S : Set H) →
    (φ : S →+ (⊤ : AddSubgroup G)) → Function.Injective φ →
    ∀ {θ γ : Ordinal.{0}},
    IsHeightPresBelowOn p φ θ →
    θ ≤ ω * α + ω →
    γ < θ →
    Order.succ γ < θ →
    Order.succ (Order.succ γ) < θ →
    ∀ {x : H}, (hpx : p • x ∈ S) →
    x ∈ ulmSubgroup p γ (G := H) →
    x ∉ ulmSubgroup p (Order.succ γ) (G := H) →
    IsProper p S x →
    (∀ y : H, y - x ∈ S → IsProper p S y →
      ulmHeight p (p • y) ≤ ulmHeight p (p • x)) →
    ∃ w : G,
      p • w = (φ ⟨p • x, hpx⟩ : G) ∧
      w ∈ ulmSubgroup p γ (G := G) ∧
      w ∉ ulmSubgroup p (Order.succ γ) (G := G) ∧
      IsProper p
        (AddMonoidHom.range ((⊤ : AddSubgroup G).subtype.comp φ)) w

namespace Context

/-- The old crossed package supplies the countdown through its proved ambient
Ulm equality below the cap. -/
noncomputable def ofStrong
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    (C : AlgBFEvenCondData p hG hH α a b) :
    Context p hG hH α a b where
  iso := C.iso
  lengths := C.lengths
  ulm_below := C.ulm_below
  presBelowCap := C.heightPresBelowCap p hG hH
  select_low := by
    intro S hSfinite φ hφinj θ γ hpres hθcap hγ hγsucc hγsuccSucc x hpx
      hxγ hxSucc hxProper hpxMax
    exact FiniteEmbedding.exists_kaplanskyTarget_of_heightPresBelow
      p hSfinite φ hφinj hpres hγ hγsucc hγsuccSucc
      (C.ulm_eq_belowCap p hG hH γ (hγ.trans_le hθcap))
      hpx hxγ hxSucc hxProper hpxMax

/-- The exact candidate supplies the same countdown interface.  Below the odd
base it uses the unchanged ambient Ulm equality.  Inside the active window it
transfers the initial Hill domination to the current finite exact stage. -/
noncomputable def ofExact
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    (C : AlgBFEvenExactCondData p hG hH α a b) :
    Context p hG hH α a b where
  iso := C.iso
  lengths := C.lengths
  ulm_below := C.ulm_below
  presBelowCap := C.heightPresBelowCap p hG hH
  select_low := by
    intro S hSfinite φ hφinj θ γ hpres hθcap hγ hγsucc hγsuccSucc x hpx
      hxγ hxSucc hxProper hpxMax
    have hγcap : γ < ω * α + ω := hγ.trans_le hθcap
    have hγsuccCap : Order.succ γ < ω * α + ω := hγsucc.trans_le hθcap
    have hγsuccSuccCap : Order.succ (Order.succ γ) < ω * α + ω :=
      hγsuccSucc.trans_le hθcap
    by_cases hbelow : γ < ω * α
    · exact FiniteEmbedding.exists_kaplanskyTarget_of_heightPresBelow
        p hSfinite φ hφinj hpres hγ hγsucc hγsuccSucc
        (C.ulm_below γ hbelow) hpx hxγ hxSucc hxProper hpxMax
    · let initial : UlmStageAt p (G := H) (H := G) γ :=
        { A := tupleSubgroup b
          B := tupleSubgroup a
          hAfinite := tupleSubgroup_finite p hH.primary b
          hBfinite := tupleSubgroup_finite p hG.primary a
          e := C.iso.equiv
          hφ_at := fun z ↦ C.heightPresBelowCap p hG hH γ hγcap z
          hφ_succ := fun z ↦
            C.heightPresBelowCap p hG hH (Order.succ γ) hγsuccCap z
          hφ_succSucc := fun z ↦
            C.heightPresBelowCap p hG hH
              (Order.succ (Order.succ γ)) hγsuccSuccCap z }
      let current := FiniteEmbedding.ulmStageAtOfInjectiveMap
        p hSfinite φ hφinj hpres hγ hγsucc hγsuccSucc
      have hinitial : hillInvariant p initial.A γ ≤
          hillInvariant p initial.B γ := by
        simpa [initial] using
          C.window.hill_forward γ (le_of_not_gt hbelow) hγcap
      have hcurrent : hillInvariant p current.A γ ≤
          hillInvariant p current.B γ :=
        ExactStageTransfer.hillInvariant_le_of_initial
          p initial current hinitial
      exact FiniteEmbedding.exists_kaplanskyTarget_of_heightPresBelow_of_hill
        p hSfinite φ hφinj hpres hγ hγsucc hγsuccSucc
        (by simpa [current] using hcurrent)
        hpx hxγ hxSucc hxProper hpxMax

end Context

/-- The established crossed package can be used wherever the countdown's
smaller context interface is expected. -/
noncomputable instance instCoeEvenCondDataContext
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {alpha : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H} :
    Coe (AlgBFEvenCondData p hG hH alpha a b)
      (Context p hG hH alpha a b) where
  coe := Context.ofStrong p hG hH

/-- The exact Hill--room package supplies the same countdown interface. -/
noncomputable instance instCoeEvenExactCondDataContext
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {alpha : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H} :
    Coe (AlgBFEvenExactCondData p hG hH alpha a b)
      (Context p hG hH alpha a b) where
  coe := Context.ofExact p hG hH

/-- A finite stage of the Case 2 high countdown.

At fuel `N`, the map preserves every filtration level below `ω*α+N`, and
it sends the part of the current source which survives to the cap
`ω*α+ω` into the exact level `ω*α+N`.  One extension step will replace
`N+1` by `N`. -/
structure Stage
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    (C : Context p hG hH α a b)
    (D : AddSubgroup H) (N : ℕ) : Type u where
  source : AddSubgroup H
  source_le : source ≤ D
  source_finite : Set.Finite (source : Set H)
  map : source →+ (⊤ : AddSubgroup G)
  map_injective : Function.Injective map
  presBelow : IsHeightPresBelowOn p map (ω * α + N)
  cap_floor : ∀ x : source,
    (x : H) ∈ ulmSubgroup p (ω * α + ω) (G := H) →
      (map x : G) ∈ ulmSubgroup p (ω * α + N) (G := G)
  mark_le : tupleSubgroup b ≤ source
  mark : ∀ x : tupleSubgroup b,
    (map ⟨(x : H), mark_le x.property⟩ : G) =
      (C.iso.equiv x : G)

/-- Literal extension of countdown stages; the amount of remaining fuel may
change, but the old map is unchanged on its old source. -/
structure Stage.Extends
    {hG : IsReducedPGroup p G} {hH : IsReducedPGroup p H}
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    {C : Context p hG hH α a b}
    {D : AddSubgroup H} {N N' : ℕ}
    (s : Stage p hG hH C D N) (t : Stage p hG hH C D N') : Prop where
  source_le : s.source ≤ t.source
  map_eq : ∀ x : s.source,
    (t.map ⟨(x : H), source_le x.property⟩ : G) = (s.map x : G)

namespace Stage.Extends

theorem refl
    {hG : IsReducedPGroup p G} {hH : IsReducedPGroup p H}
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    {C : Context p hG hH α a b}
    {D : AddSubgroup H} {N : ℕ}
    (s : Stage p hG hH C D N) : Stage.Extends p s s :=
  ⟨le_rfl, fun _ ↦ rfl⟩

theorem trans
    {hG : IsReducedPGroup p G} {hH : IsReducedPGroup p H}
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    {C : Context p hG hH α a b}
    {D : AddSubgroup H} {N₁ N₂ N₃ : ℕ}
    {s : Stage p hG hH C D N₁}
    {t : Stage p hG hH C D N₂}
    {u : Stage p hG hH C D N₃}
    (hst : Stage.Extends p s t) (htu : Stage.Extends p t u) :
    Stage.Extends p s u := by
  refine ⟨hst.source_le.trans htu.source_le, ?_⟩
  intro x
  calc
    (u.map ⟨(x : H), htu.source_le (hst.source_le x.property)⟩ : G) =
        (t.map ⟨(x : H), hst.source_le x.property⟩ : G) :=
      htu.map_eq ⟨(x : H), hst.source_le x.property⟩
    _ = (s.map x : G) := hst.map_eq x

/-- Transporting only the fuel index does not change the underlying stage. -/
theorem cast
    {hG : IsReducedPGroup p G} {hH : IsReducedPGroup p H}
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    {C : Context p hG hH α a b}
    {D : AddSubgroup H} {N N' : ℕ}
    (s : Stage p hG hH C D N) (h : N = N') :
    Stage.Extends p s (h ▸ s) := by
  subst N'
  exact refl p s

end Stage.Extends

/-- The current even tuple map starts the countdown at any finite cutoff
strictly below the omega cap. -/
noncomputable def Stage.initial
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    (C : Context p hG hH α a b)
    (D : AddSubgroup H) (hmarkD : tupleSubgroup b ≤ D)
    (N : ℕ) (hNcap : ω * α + N < ω * α + ω) :
    Stage p hG hH C D N := by
  let raw : tupleSubgroup b →+ G :=
    (tupleSubgroup a).subtype.comp C.iso.equiv.toAddMonoidHom
  let f : tupleSubgroup b →+ (⊤ : AddSubgroup G) :=
    raw.codRestrict ⊤ (fun _ ↦ by simp)
  refine
    { source := tupleSubgroup b
      source_le := hmarkD
      source_finite := tupleSubgroup_finite p hH.primary b
      map := f
      map_injective := ?_
      presBelow := ?_
      cap_floor := ?_
      mark_le := le_rfl
      mark := ?_ }
  · intro x y hxy
    apply C.iso.equiv.injective
    apply Subtype.ext
    exact congrArg (fun z : (⊤ : AddSubgroup G) ↦ (z : G)) hxy
  · intro β hβ x
    simpa [f, raw] using
      C.presBelowCap β (hβ.trans hNcap) x
  · intro x hxcap
    have hxN : (x : H) ∈ ulmSubgroup p (ω * α + N) (G := H) :=
      ulmSubgroup_antitone p (le_of_lt hNcap) hxcap
    have hmap :=
      (C.presBelowCap (ω * α + N) hNcap x).mp hxN
    simpa [f, raw] using hmap
  · intro x
    rfl

/-- A finite subgroup sees the `base + omega` tail at some finite stage of
the descending filtration. -/
theorem exists_finite_tail_cutoff
    (D : AddSubgroup H) (hD : Set.Finite (D : Set H))
    (base : Ordinal.{0}) :
    ∃ M : ℕ,
      D ⊓ ulmSubgroup p (base + M) (G := H) ≤
        ulmSubgroup p (base + ω) (G := H) := by
  classical
  letI : Finite D := hD.to_subtype
  letI : Fintype D := Fintype.ofFinite D
  have hlim : Order.IsSuccLimit (base + ω) :=
    Ordinal.isSuccLimit_add base Ordinal.isSuccLimit_omega0
  have hwitness : ∀ x : D,
      (x : H) ∉ ulmSubgroup p (base + ω) (G := H) →
        ∃ n : ℕ, (x : H) ∉ ulmSubgroup p (base + n) (G := H) := by
    intro x hxcap
    rw [mem_ulmSubgroup_limit_iff (p := p) (G := H) hlim] at hxcap
    push Not at hxcap
    obtain ⟨β, hβcap, hxβ⟩ := hxcap
    have hβsup : β < ⨆ n : ℕ, base + n := by
      simpa using hβcap
    obtain ⟨n, hβn⟩ := Ordinal.lt_iSup_iff.mp hβsup
    refine ⟨n, ?_⟩
    intro hxn
    exact hxβ (ulmSubgroup_antitone p (le_of_lt hβn) hxn)
  let reach : D → ℕ := fun x ↦
    if hx : (x : H) ∈ ulmSubgroup p (base + ω) (G := H) then 0
    else Classical.choose (hwitness x hx)
  let M : ℕ := ∑ x : D, reach x
  refine ⟨M, ?_⟩
  intro x hx
  let xD : D := ⟨x, hx.1⟩
  by_contra hxcap
  have hxreach :
      (x : H) ∉ ulmSubgroup p (base + reach xD) (G := H) := by
    dsimp only [reach]
    rw [dif_neg hxcap]
    exact Classical.choose_spec (hwitness xD hxcap)
  have hle : reach xD ≤ M := by
    exact Finset.single_le_sum (fun _ _ ↦ Nat.zero_le _)
      (Finset.mem_univ xD)
  have hleord : (reach xD : Ordinal.{0}) ≤ (M : Ordinal.{0}) := by
    exact_mod_cast hle
  apply hxreach
  exact ulmSubgroup_antitone p ((add_le_add_iff_left base).2 hleord) hx.2

/-- In a long even window, a high root can be perturbed by a fresh filtered
socle direction so that it avoids a prescribed finite range. -/
theorem exists_high_target_outside_range
    (hG : IsReducedPGroup p G)
    {α : Ordinal.{0}} {N : ℕ}
    (hlong : ω * α + ω ≤ (ulmLength p (G := G) hG : Ordinal.{0}))
    {S : AddSubgroup H} (hSfinite : Set.Finite (S : Set H))
    (φ : S →+ (⊤ : AddSubgroup G))
    (y : G)
    (hy : y ∈ ulmSubgroup p (ω * α + (N + 1)) (G := G)) :
    ∃ w : G,
      p • w = y ∧
      w ∈ ulmSubgroup p (ω * α + N) (G := G) ∧
      w ∉ AddMonoidHom.range ((⊤ : AddSubgroup G).subtype.comp φ) := by
  classical
  let raw : S →+ G := (⊤ : AddSubgroup G).subtype.comp φ
  let R : AddSubgroup G := AddMonoidHom.range raw
  have hySucc : y ∈
      ulmSubgroup p (Order.succ (ω * α + N)) (G := G) := by
    simpa [Order.succ_eq_add_one, Nat.cast_add, Nat.cast_one,
      ← add_assoc] using hy
  rw [mem_ulmSubgroup_succ_iff] at hySucc
  obtain ⟨w₁, hw₁, hpw₁⟩ := hySucc
  have hβbase : ω * α ≤ ω * α + (N : Ordinal.{0}) := le_self_add
  have hβcap : ω * α + (N : Ordinal.{0}) < ω * α + ω := by
    rw [add_lt_add_iff_left]
    exact Ordinal.natCast_lt_omega0 N
  have hPinf : Set.Infinite
      (pSocleAt p (ω * α + N) (G := G) : Set G) :=
    AlgBFEvenCondData.infinite_pSocleAt_of_longWindow
      p hG hlong hβbase hβcap
  have hRfinite : Set.Finite (R : Set G) := by
    letI : Finite S := hSfinite.to_subtype
    change Set.Finite (Set.range raw)
    exact Set.finite_range raw
  have hR₁finite : Set.Finite (adjoinElem R w₁ : Set G) :=
    adjoinElem_finite (p := p) hG.primary hRfinite w₁
  have hex : ∃ w₂ : G,
      w₂ ∈ pSocleAt p (ω * α + N) (G := G) ∧
      w₂ ∉ adjoinElem R w₁ := by
    by_contra hnone
    push Not at hnone
    apply hPinf
    exact hR₁finite.subset (fun z hz ↦ hnone z hz)
  obtain ⟨w₂, hw₂P, hw₂out⟩ := hex
  have hpw₂ : p • w₂ = 0 := (mem_pSocleAt p _ w₂).1 hw₂P |>.1
  have hw₂ : w₂ ∈ ulmSubgroup p (ω * α + N) (G := G) :=
    (mem_pSocleAt p _ w₂).1 hw₂P |>.2
  let w : G := w₁ + w₂
  refine ⟨w, by simp [w, smul_add, hpw₁, hpw₂],
    (ulmSubgroup p (ω * α + N)).add_mem hw₁ hw₂, ?_⟩
  intro hwR
  apply hw₂out
  have hwR' : w ∈ R := hwR
  have hw₁adj : w₁ ∈ adjoinElem R w₁ := mem_adjoinElem_right R w₁
  have hwjadj : w ∈ adjoinElem R w₁ := le_adjoinElem R w₁ hwR'
  have hw₂eq : w₂ = w - w₁ := by simp [w]
  rw [hw₂eq]
  exact (adjoinElem R w₁).sub_mem hwjadj hw₁adj

/-- The low branch of one countdown step.  A normalized representative which
does not survive to the omega cap has an exact height below the finite
stabilization cutoff.  The cutoff-local Kaplansky theorem then supplies a
proper target representative of the same height. -/
theorem Stage.extend_low
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    (C : Context p hG hH α a b)
    (D : AddSubgroup H) (M N : ℕ)
    (hstab : D ⊓ ulmSubgroup p (ω * α + M) (G := H) ≤
      ulmSubgroup p (ω * α + ω) (G := H))
    (hMN : M + 3 ≤ N)
    (s : Stage p hG hH C D (N + 1))
    {x : H} (hxD : x ∈ D) (hx : x ∉ s.source)
    (hxcap : x ∉ ulmSubgroup p (ω * α + ω) (G := H))
    (hpx : p • x ∈ s.source)
    (hxProper : IsProper p s.source x)
    (hpxMax : ∀ y : H, y - x ∈ s.source → IsProper p s.source y →
      ulmHeight p (p • y) ≤ ulmHeight p (p • x)) :
    ∃ t : Stage p hG hH C D N,
      Stage.Extends p s t ∧ x ∈ t.source := by
  have hx0 : x ≠ 0 := by
    intro hx0
    apply hx
    simpa [hx0]
  obtain ⟨γ, hxγ, hxSucc⟩ :=
    exists_ulmHeight_eq_of_ne_zero (p := p) hH hx0
  have hxM : x ∉ ulmSubgroup p (ω * α + M) (G := H) := by
    intro hxM
    exact hxcap (hstab ⟨hxD, hxM⟩)
  have hγM : γ < ω * α + M := by
    by_contra hnot
    exact hxM (ulmSubgroup_antitone p (le_of_not_gt hnot) hxγ)
  have hMcap : ω * α + M < ω * α + ω := by
    rw [add_lt_add_iff_left]
    exact Ordinal.natCast_lt_omega0 M
  have hMold : ω * α + M < ω * α + (N + 1) := by
    rw [add_lt_add_iff_left]
    have hMN' : M < N + 1 := by omega
    exact_mod_cast hMN'
  have hγold : γ < ω * α + (N + 1) := hγM.trans hMold
  have hsuccγM : Order.succ γ ≤ ω * α + M :=
    Order.succ_le_iff.mpr hγM
  have hsuccγold : Order.succ γ < ω * α + (N + 1) :=
    hsuccγM.trans_lt hMold
  have hMMN : M + 1 < N + 1 := by omega
  have hsuccMold : Order.succ (ω * α + M) < ω * α + (N + 1) := by
    have hMMNord : (M + 1 : Ordinal.{0}) < (N + 1 : Ordinal.{0}) := by
      exact_mod_cast hMMN
    simpa [Order.succ_eq_add_one, Nat.cast_add, Nat.cast_one,
      ← add_assoc] using
      ((add_lt_add_iff_left (ω * α)).2 hMMNord)
  have hsuccsuccγold :
      Order.succ (Order.succ γ) < ω * α + (N + 1) :=
    (Order.succ_le_succ hsuccγM).trans_lt hsuccMold
  have holdCap : ω * α + (N + 1) < ω * α + ω := by
    rw [add_lt_add_iff_left]
    exact Ordinal.natCast_lt_omega0 (N + 1)
  obtain ⟨w, hpw, hwγ, hwSucc, hwProper⟩ :=
    C.select_low s.source_finite s.map s.map_injective
      s.presBelow (le_of_lt holdCap) hγold hsuccγold hsuccsuccγold
      hpx hxγ hxSucc hxProper hpxMax
  obtain ⟨φ', hφS, hφx, hφpresOld⟩ :=
    FiniteEmbedding.socle_extend_build_map_heightPresBelow
      p s.map s.presBelow hx hpx hpw hxγ hxSucc hwγ hwSucc
      hxProper hwProper
  have hφinj : Function.Injective φ' :=
    FiniteEmbedding.socle_extend_build_map_injective_of_heightPresBelow
      p s.map s.map_injective hxγ hxSucc hxProper hpx φ' hφS
      hφpresOld hsuccγold
  let S' : AddSubgroup H := adjoinElem s.source x
  have hS'D : S' ≤ D := by
    intro z hz
    obtain ⟨y, hy, k, hrepr⟩ :=
      (mem_adjoinElem_iff (A := s.source) (g := x)).mp hz
    rw [← hrepr]
    exact D.add_mem (s.source_le hy) (D.zsmul_mem hxD k)
  have hS'finite : Set.Finite (S' : Set H) :=
    adjoinElem_finite (p := p) hH.primary s.source_finite x
  have hnewOld : ω * α + N < ω * α + (N + 1) := by
    rw [add_lt_add_iff_left]
    exact_mod_cast Nat.lt_succ_self N
  have hφpresNew : IsHeightPresBelowOn p φ' (ω * α + N) := by
    intro β hβ
    exact hφpresOld β (hβ.trans hnewOld)
  have hsuccγcap : Order.succ γ ≤ ω * α + ω :=
    hsuccγM.trans (le_of_lt hMcap)
  have hcapFloor : ∀ z : S',
      (z : H) ∈ ulmSubgroup p (ω * α + ω) (G := H) →
        (φ' z : G) ∈ ulmSubgroup p (ω * α + N) (G := G) := by
    intro z hzcap
    obtain ⟨y, hy, k, hrepr⟩ :=
      (mem_adjoinElem_iff (A := s.source) (g := x)).mp z.property
    by_cases hk : (p : ℤ) ∣ k
    · obtain ⟨q, rfl⟩ := hk
      let y' : s.source :=
        ⟨y + q • (p • x), s.source.add_mem hy (s.source.zsmul_mem hpx q)⟩
      have hzold : (z : H) = (y' : H) := by
        rw [← hrepr]
        change y + ((p : ℤ) * q) • x = y + q • (p • x)
        simp [mul_zsmul, Int.mul_comm]
      have hycap : (y' : H) ∈
          ulmSubgroup p (ω * α + ω) (G := H) := by
        simpa [hzold] using hzcap
      have hymap := s.cap_floor y' hycap
      have hmapold : (φ' z : G) = (s.map y' : G) := by
        rw [show z =
          ⟨(y' : H), le_adjoinElem s.source x y'.property⟩ by
            exact Subtype.ext hzold]
        exact hφS y'
      rw [hmapold]
      exact ulmSubgroup_antitone p (le_of_lt hnewOld) hymap
    · exfalso
      have hznot : (z : H) ∉
          ulmSubgroup p (Order.succ γ) (G := H) := by
        rw [← hrepr]
        exact not_mem_succ_add_zsmul_of_proper p hxγ hxSucc hxProper
          hpx ⟨y, hy⟩ k hk
      exact hznot (ulmSubgroup_antitone p hsuccγcap hzcap)
  let t : Stage p hG hH C D N :=
    { source := S'
      source_le := hS'D
      source_finite := hS'finite
      map := φ'
      map_injective := hφinj
      presBelow := hφpresNew
      cap_floor := hcapFloor
      mark_le := s.mark_le.trans (le_adjoinElem s.source x)
      mark := fun z ↦ by
        simpa using (hφS ⟨(z : H), s.mark_le z.property⟩).trans (s.mark z) }
  refine ⟨t, ⟨le_adjoinElem s.source x, ?_⟩,
    mem_adjoinElem_right s.source x⟩
  exact hφS

/-- The high branch of one countdown step.  A representative at the omega
cap is sent to a root at the new finite cutoff.  Freshness outside the old
range gives injectivity, while cap membership on both sides gives the new
cutoff equivalence. -/
theorem Stage.extend_high
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    (C : Context p hG hH α a b)
    (D : AddSubgroup H) (N : ℕ)
    (s : Stage p hG hH C D (N + 1))
    {x : H} (hxD : x ∈ D) (hx : x ∉ s.source)
    (hxcap : x ∈ ulmSubgroup p (ω * α + ω) (G := H))
    (hpx : p • x ∈ s.source) :
    ∃ t : Stage p hG hH C D N,
      Stage.Extends p s t ∧ x ∈ t.source := by
  have hx0 : x ≠ 0 := by
    intro hx0
    apply hx
    simpa [hx0]
  have hlong : ω * α + ω ≤
      (ulmLength p (G := G) hG : Ordinal.{0}) := by
    rcases C.lengths with hshort | hlong
    · have hHlen : (ulmLength p (G := H) hH : Ordinal.{0}) <
          ω * α + ω := by
        simpa [← hshort.1] using hshort.2
      have hxlen : x ∈
          ulmSubgroup p (ulmLength p (G := H) hH) (G := H) :=
        ulmSubgroup_antitone p (le_of_lt hHlen) hxcap
      have : x = 0 := by
        simpa [ulmLength.at_ulmLength (p := p) (hred := hH)] using hxlen
      exact False.elim (hx0 this)
    · exact hlong.1
  let pxS : s.source := ⟨p • x, hpx⟩
  have hpxcap : p • x ∈
      ulmSubgroup p (ω * α + ω) (G := H) :=
    (ulmSubgroup p (ω * α + ω) (G := H)).nsmul_mem hxcap p
  have hy := s.cap_floor pxS hpxcap
  obtain ⟨w, hpw, hwN, hwout⟩ :=
    exists_high_target_outside_range p hG hlong s.source_finite s.map
      (s.map pxS : G) hy
  have hNcap : ω * α + N < ω * α + ω := by
    rw [add_lt_add_iff_left]
    exact Ordinal.natCast_lt_omega0 N
  have hxN : x ∈ ulmSubgroup p (ω * α + N) (G := H) :=
    ulmSubgroup_antitone p (le_of_lt hNcap) hxcap
  have hnewOld : ω * α + N < ω * α + (N + 1) := by
    rw [add_lt_add_iff_left]
    exact_mod_cast Nat.lt_succ_self N
  have hpresNew : IsHeightPresBelowOn p s.map (ω * α + N) := by
    intro β hβ
    exact s.presBelow β (hβ.trans hnewOld)
  obtain ⟨φ', hφS, hφx, hφpres⟩ :=
    FiniteEmbedding.socle_extend_build_map_heightPresBelow_of_mem
      p s.map hpresNew hx hpx hpw hxN hwN
  have hφinj : Function.Injective φ' :=
    FiniteEmbedding.socle_extend_build_map_injective_of_not_mem_range
      p s.map s.map_injective hpx hpw hwout φ' hφS hφx
  let S' : AddSubgroup H := adjoinElem s.source x
  have hS'D : S' ≤ D := by
    intro z hz
    obtain ⟨y, hyS, k, hrepr⟩ :=
      (mem_adjoinElem_iff (A := s.source) (g := x)).mp hz
    rw [← hrepr]
    exact D.add_mem (s.source_le hyS) (D.zsmul_mem hxD k)
  have hS'finite : Set.Finite (S' : Set H) :=
    adjoinElem_finite (p := p) hH.primary s.source_finite x
  have hcapFloor : ∀ z : S',
      (z : H) ∈ ulmSubgroup p (ω * α + ω) (G := H) →
        (φ' z : G) ∈ ulmSubgroup p (ω * α + N) (G := G) := by
    intro z hzcap
    obtain ⟨y, hyS, k, hrepr⟩ :=
      (mem_adjoinElem_iff (A := s.source) (g := x)).mp z.property
    let yS : s.source := ⟨y, hyS⟩
    have hycap : (yS : H) ∈
        ulmSubgroup p (ω * α + ω) (G := H) := by
      have hkcap :=
        (ulmSubgroup p (ω * α + ω) (G := H)).zsmul_mem hxcap k
      have := (ulmSubgroup p (ω * α + ω) (G := H)).sub_mem hzcap hkcap
      simpa [← hrepr] using this
    have hymapOld := s.cap_floor yS hycap
    have hymap : (s.map yS : G) ∈
        ulmSubgroup p (ω * α + N) (G := G) :=
      ulmSubgroup_antitone p (le_of_lt hnewOld) hymapOld
    have hmap : (φ' z : G) = (s.map yS : G) + k • w := by
      let y' : S' := ⟨y, le_adjoinElem s.source x hyS⟩
      let x' : S' := ⟨x, mem_adjoinElem_right s.source x⟩
      have hzrepr : z = y' + k • x' := by
        apply Subtype.ext
        simpa [y', x'] using hrepr.symm
      rw [hzrepr, map_add, map_zsmul]
      change (φ' y' : G) + k • (φ' x' : G) =
        (s.map yS : G) + k • w
      rw [show (φ' y' : G) = (s.map yS : G) by
        simpa [y', yS] using hφS yS]
      rw [show (φ' x' : G) = w by simpa [x'] using hφx]
    rw [hmap]
    exact (ulmSubgroup p (ω * α + N) (G := G)).add_mem hymap
      ((ulmSubgroup p (ω * α + N) (G := G)).zsmul_mem hwN k)
  let t : Stage p hG hH C D N :=
    { source := S'
      source_le := hS'D
      source_finite := hS'finite
      map := φ'
      map_injective := hφinj
      presBelow := hφpres
      cap_floor := hcapFloor
      mark_le := s.mark_le.trans (le_adjoinElem s.source x)
      mark := fun z ↦ by
        simpa using (hφS ⟨(z : H), s.mark_le z.property⟩).trans (s.mark z) }
  refine ⟨t, ⟨le_adjoinElem s.source x, ?_⟩,
    mem_adjoinElem_right s.source x⟩
  exact hφS

/-- Spend one unit of fuel without changing the map. -/
noncomputable def Stage.lower
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    (C : Context p hG hH α a b)
    (D : AddSubgroup H) (N : ℕ)
    (s : Stage p hG hH C D (N + 1)) :
    Stage p hG hH C D N := by
  have hnewOld : ω * α + N < ω * α + (N + 1) := by
    rw [add_lt_add_iff_left]
    exact_mod_cast Nat.lt_succ_self N
  exact
    { source := s.source
      source_le := s.source_le
      source_finite := s.source_finite
      map := s.map
      map_injective := s.map_injective
      presBelow := fun β hβ ↦ s.presBelow β (hβ.trans hnewOld)
      cap_floor := fun x hx ↦
        ulmSubgroup_antitone p (le_of_lt hnewOld) (s.cap_floor x hx)
      mark_le := s.mark_le
      mark := s.mark }

/-- One prescribed-root step of the finite high countdown.  Kaplansky
normalization is performed once; membership at the omega cap then selects the
high branch, and failure of cap membership selects the exact-height low
branch. -/
theorem Stage.extend_one
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    (C : Context p hG hH α a b)
    (D : AddSubgroup H) (M N : ℕ)
    (hstab : D ⊓ ulmSubgroup p (ω * α + M) (G := H) ≤
      ulmSubgroup p (ω * α + ω) (G := H))
    (hMN : M + 3 ≤ N)
    (s : Stage p hG hH C D (N + 1)) (g : D)
    (hpg : p • (g : H) ∈ s.source) :
    ∃ t : Stage p hG hH C D N,
      Stage.Extends p s t ∧ (g : H) ∈ t.source := by
  by_cases hg : (g : H) ∈ s.source
  · let t := s.lower p hG hH C D N
    exact ⟨t, ⟨le_rfl, fun _ ↦ rfl⟩, hg⟩
  obtain ⟨x, hxg, hxProper, hpxMax'⟩ :=
    exists_kaplanskyNormalized (p := p) s.source_finite (g : H)
  have hxD : x ∈ D := by
    have hrepr : x = (g : H) + (x - (g : H)) := by abel
    rw [hrepr]
    exact D.add_mem g.property (s.source_le hxg)
  have hx : x ∉ s.source := by
    intro hxS
    apply hg
    have hrepr : (g : H) = x - (x - (g : H)) := by abel
    rw [hrepr]
    exact s.source.sub_mem hxS hxg
  have hpx : p • x ∈ s.source := by
    have hrepr : p • x = p • (g : H) + p • (x - (g : H)) := by
      rw [smul_sub]
      abel
    rw [hrepr]
    exact s.source.add_mem hpg (s.source.nsmul_mem hxg p)
  have hpxMax : ∀ y : H, y - x ∈ s.source → IsProper p s.source y →
      ulmHeight p (p • y) ≤ ulmHeight p (p • x) := by
    intro y hyx hyProper
    apply hpxMax' y
    · have : y - (g : H) = (y - x) + (x - (g : H)) := by abel
      rw [this]
      exact s.source.add_mem hyx hxg
    · exact hyProper
  have finish : ∀ (t : Stage p hG hH C D N),
      Stage.Extends p s t → x ∈ t.source →
      ∃ u : Stage p hG hH C D N,
        Stage.Extends p s u ∧ (g : H) ∈ u.source := by
    intro t hst hxt
    refine ⟨t, hst, ?_⟩
    have hxg' : x - (g : H) ∈ t.source := hst.source_le hxg
    have hrepr : (g : H) = x - (x - (g : H)) := by abel
    rw [hrepr]
    exact t.source.sub_mem hxt hxg'
  by_cases hxcap : x ∈ ulmSubgroup p (ω * α + ω) (G := H)
  · obtain ⟨t, hst, hxt⟩ :=
      s.extend_high p hG hH C D N hxD hx hxcap hpx
    exact finish t hst hxt
  · obtain ⟨t, hst, hxt⟩ :=
      s.extend_low p hG hH C D M N hstab hMN hxD hx hxcap hpx
        hxProper hpxMax
    exact finish t hst hxt

/-- Absorb one prescribed element using exactly `k` countdown steps, starting
from a stage which already contains its `p^k`-multiple. -/
theorem Stage.extend_pow_to_mem
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    (C : Context p hG hH α a b)
    (D : AddSubgroup H) (M N : ℕ)
    (hstab : D ⊓ ulmSubgroup p (ω * α + M) (G := H) ≤
      ulmSubgroup p (ω * α + ω) (G := H))
    (hMN : M + 3 ≤ N) (k : ℕ)
    (s : Stage p hG hH C D (N + k)) (g : D)
    (hpow : p ^ k • (g : H) ∈ s.source) :
    ∃ t : Stage p hG hH C D N,
      Stage.Extends p s t ∧ (g : H) ∈ t.source := by
  induction k with
  | zero =>
      have hg : (g : H) ∈ s.source := by simpa using hpow
      exact ⟨s, Stage.Extends.refl p s, hg⟩
  | succ k ih =>
      let y : D :=
        ⟨p ^ k • (g : H), D.nsmul_mem g.property (p ^ k)⟩
      have hpy : p • (y : H) ∈ s.source := by
        simpa [y, pow_succ, mul_smul, Nat.mul_comm, Nat.add_comm,
          Nat.add_left_comm, Nat.add_assoc] using hpow
      have hMNk : M + 3 ≤ N + k := hMN.trans (Nat.le_add_right N k)
      let s' : Stage p hG hH C D ((N + k) + 1) := by
        simpa only [Nat.add_succ] using s
      obtain ⟨t₁, hst₁, hy₁⟩ :=
        s'.extend_one p hG hH C D M (N + k) hstab hMNk y
          (by simpa [s'] using hpy)
      obtain ⟨t₂, ht₁t₂, hg₂⟩ := ih t₁ hy₁
      have hst₁' : Stage.Extends p s t₁ := by
        simpa [s', Nat.add_assoc] using hst₁
      exact ⟨t₂, Stage.Extends.trans p hst₁' ht₁t₂, hg₂⟩

/-- Iterate a uniform `k`-step absorption over a finite list.  The fuel
formula is explicit, so every call to `extend_one` is made above the reserved
low-branch margin `M+3`. -/
theorem Stage.extend_list
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    (C : Context p hG hH α a b)
    (D : AddSubgroup H) (M N k : ℕ)
    (hstab : D ⊓ ulmSubgroup p (ω * α + M) (G := H) ≤
      ulmSubgroup p (ω * α + ω) (G := H))
    (hMN : M + 3 ≤ N)
    (hkill : ∀ g : D, p ^ k • (g : H) = 0)
    (l : List D) (s : Stage p hG hH C D (N + k * l.length)) :
    ∃ t : Stage p hG hH C D N,
      Stage.Extends p s t ∧ ∀ g ∈ l, (g : H) ∈ t.source := by
  induction l with
  | nil =>
      exact ⟨s, Stage.Extends.refl p s, by simp⟩
  | cons g l ih =>
      have hsFuel : N + k * (g :: l).length =
          (N + k * l.length) + k := by simp [Nat.mul_add, Nat.add_assoc]
      let s' : Stage p hG hH C D ((N + k * l.length) + k) := hsFuel ▸ s
      have hss' : Stage.Extends p s s' :=
        Stage.Extends.cast p s hsFuel
      obtain ⟨t₁, hst₁, hg₁⟩ :=
        s'.extend_pow_to_mem p hG hH C D M (N + k * l.length)
          hstab (hMN.trans (Nat.le_add_right N (k * l.length))) k g
          (by simp [hkill g])
      obtain ⟨t₂, ht₁t₂, hlt₂⟩ := ih t₁
      have hst₁' : Stage.Extends p s t₁ := by
        exact Stage.Extends.trans p hss' hst₁
      refine ⟨t₂, Stage.Extends.trans p hst₁' ht₁t₂, ?_⟩
      intro z hz
      simp only [List.mem_cons] at hz
      rcases hz with rfl | hz
      · exact ht₁t₂.source_le hg₁
      · exact hlt₂ z hz

/-- Complete the countdown on an arbitrary finite challenge subgroup.

The output is already in the form consumed by the ACM high-phase seam:
injective, exact below the odd base, directionally truncated above it, and
literally equal to the old marked map. -/
theorem finite_countdown_within
    (hG : IsReducedPGroup p G) (hH : IsReducedPGroup p H)
    {α : Ordinal.{0}} {a : Fin n → G} {b : Fin n → H}
    (C : Context p hG hH α a b)
    (D : AddSubgroup H) (hD : Set.Finite (D : Set H))
    (hmarkD : tupleSubgroup b ≤ D) :
    ∃ f : D →+ (⊤ : AddSubgroup G),
      Function.Injective f ∧
      IsHeightPresBelowOn p f (ω * α) ∧
      ((ulmLength p (G := H) hH : Ordinal.{0}) < ω * α + ω →
        IsHeightPresBelowOn p f (ω * α + ω)) ∧
      (∀ x : D,
        min (ulmHeight p (f x : G))
            ((ω * α + ω : Ordinal.{0}) : WithTop Ordinal.{0}) ≤
          ulmHeight p (x : H)) ∧
      ∀ x : tupleSubgroup b,
        (f ⟨(x : H), hmarkD x.property⟩ : G) =
          (C.iso.equiv x : G) := by
  classical
  obtain ⟨M, hstab⟩ := exists_finite_tail_cutoff p D hD (ω * α)
  letI : Fintype D := hD.fintype
  have hDprimary : IsPrimaryPGroup p D := by
    intro x
    obtain ⟨k, hk⟩ := hH.primary (x : H)
    exact ⟨k, Subtype.ext hk⟩
  obtain ⟨k, hkill⟩ := finite_primary_bounded_exponent p hDprimary
  let l : List D := Finset.univ.toList
  let fuel : ℕ := M + 3 + k * l.length
  have hfuelCap : ω * α + fuel < ω * α + ω := by
    rw [add_lt_add_iff_left]
    exact Ordinal.natCast_lt_omega0 fuel
  let s₀ : Stage p hG hH C D fuel :=
    Stage.initial p hG hH C D hmarkD fuel hfuelCap
  obtain ⟨t, hs₀t, hall⟩ :=
    s₀.extend_list p hG hH C D M (M + 3) k hstab le_rfl
      (fun g ↦ congrArg Subtype.val (hkill g)) l
  have htall : ∀ x : D, (x : H) ∈ t.source := by
    intro x
    exact hall x (by simp [l])
  let ι : D →+ t.source :=
    { toFun := fun x ↦ ⟨(x : H), htall x⟩
      map_zero' := Subtype.ext rfl
      map_add' := fun _ _ ↦ Subtype.ext rfl }
  let f : D →+ (⊤ : AddSubgroup G) := t.map.comp ι
  have hι : Function.Injective ι := by
    intro x y hxy
    exact Subtype.ext (congrArg (fun z : t.source ↦ (z : H)) hxy)
  have hbaseFinal : ω * α <
      ω * α + ((M + 3 : ℕ) : Ordinal.{0}) := by
    suffices ω * α + 0 <
        ω * α + ((M + 3 : ℕ) : Ordinal.{0}) by simpa only [add_zero] using this
    rw [add_lt_add_iff_left]
    have : 0 < M + 3 := by omega
    exact_mod_cast this
  have hpresBase : IsHeightPresBelowOn p f (ω * α) := by
    intro β hβ x
    exact t.presBelow β (hβ.trans hbaseFinal) (ι x)
  have hexact : ∀ x : D,
      (x : H) ∉ ulmSubgroup p (ω * α + ω) (G := H) →
        ulmHeight p (f x : G) = ulmHeight p (x : H) := by
    intro x hxcap
    have hxM : (x : H) ∉
          ulmSubgroup p (ω * α + M) (G := H) := by
      intro hxM
      exact hxcap (hstab ⟨x.property, hxM⟩)
    have hx0 : (x : H) ≠ 0 := by
      intro hx0
      apply hxcap
      simp [hx0]
    obtain ⟨γ, hxγ, hxSucc⟩ :=
      exists_ulmHeight_eq_of_ne_zero (p := p) hH hx0
    have hγM : γ < ω * α + M := by
      by_contra hnot
      exact hxM (ulmSubgroup_antitone p (le_of_not_gt hnot) hxγ)
    have hMfinal : ω * α + M <
        ω * α + ((M + 3 : ℕ) : Ordinal.{0}) := by
      rw [add_lt_add_iff_left]
      have : M < M + 3 := by omega
      exact_mod_cast this
    have hγfinal : γ <
        ω * α + ((M + 3 : ℕ) : Ordinal.{0}) := hγM.trans hMfinal
    have hsuccγfinal : Order.succ γ <
        ω * α + ((M + 3 : ℕ) : Ordinal.{0}) :=
      (Order.succ_le_iff.mpr hγM).trans_lt hMfinal
    have hfγ : (f x : G) ∈ ulmSubgroup p γ (G := G) :=
      (t.presBelow γ hγfinal (ι x)).mp hxγ
    have hfSucc : (f x : G) ∉
          ulmSubgroup p (Order.succ γ) (G := G) := by
      intro hf
      exact hxSucc ((t.presBelow (Order.succ γ) hsuccγfinal (ι x)).mpr hf)
    have hxheight : ulmHeight p (x : H) =
        (γ : WithTop Ordinal.{0}) :=
      ulmHeight_eq_of_mem_not_mem_succ p (x : H) γ hxγ hxSucc
    have hfheight : ulmHeight p (f x : G) =
        (γ : WithTop Ordinal.{0}) :=
      ulmHeight_eq_of_mem_not_mem_succ p (f x : G) γ hfγ hfSucc
    exact hfheight.trans hxheight.symm
  have hpresCap : (ulmLength p (G := H) hH : Ordinal.{0}) <
      ω * α + ω → IsHeightPresBelowOn p f (ω * α + ω) := by
    intro hlen β _hβ x
    by_cases hx0 : (x : H) = 0
    · have hx : x = 0 := Subtype.ext hx0
      subst x
      simp
    · have hxcap : (x : H) ∉
          ulmSubgroup p (ω * α + ω) (G := H) := by
        intro hxcap
        have hxlen : (x : H) ∈
            ulmSubgroup p (ulmLength p (G := H) hH) (G := H) :=
          ulmSubgroup_antitone p (le_of_lt hlen) hxcap
        apply hx0
        simpa [ulmLength.at_ulmLength (p := p) (hred := hH)] using hxlen
      rw [mem_ulmSubgroup_iff_le_ulmHeight,
        mem_ulmSubgroup_iff_le_ulmHeight, hexact x hxcap]
  have hreverse : ∀ x : D,
      min (ulmHeight p (f x : G))
          ((ω * α + ω : Ordinal.{0}) : WithTop Ordinal.{0}) ≤
        ulmHeight p (x : H) := by
    intro x
    by_cases hxcap : (x : H) ∈
        ulmSubgroup p (ω * α + ω) (G := H)
    · exact (min_le_right _ _).trans
        ((mem_ulmSubgroup_iff_le_ulmHeight p (x : H) (ω * α + ω)).mp hxcap)
    · calc
        min (ulmHeight p (f x : G))
            ((ω * α + ω : Ordinal.{0}) : WithTop Ordinal.{0}) ≤
            ulmHeight p (f x : G) := min_le_left _ _
        _ = ulmHeight p (x : H) := hexact x hxcap
  have hmark : ∀ x : tupleSubgroup b,
      (f ⟨(x : H), hmarkD x.property⟩ : G) =
        (C.iso.equiv x : G) := by
    intro x
    change (t.map (ι ⟨(x : H), hmarkD x.property⟩) : G) =
      (C.iso.equiv x : G)
    have hιx : ι ⟨(x : H), hmarkD x.property⟩ =
        ⟨(x : H), hs₀t.source_le x.property⟩ := Subtype.ext rfl
    rw [hιx, hs₀t.map_eq]
    exact s₀.mark x
  exact ⟨f, t.map_injective.comp hι, hpresBase, hpresCap, hreverse, hmark⟩

end EvenHighCountdown
